local function theme(a, b)
	local lum = 0.299 * a.R + 0.587 * a.G + 0.114 * a.B
	return {
		bg = Color3.fromRGB(10, 10, 14), surface = Color3.fromRGB(17, 17, 23),
		raised = Color3.fromRGB(27, 27, 36), line = Color3.fromRGB(44, 44, 58),
		text = Color3.fromRGB(238, 240, 246), sub = Color3.fromRGB(142, 147, 164),
		accent = a, accent2 = b,
		onAccent = lum > 0.62 and Color3.fromRGB(12, 12, 16) or Color3.new(1, 1, 1),
		ok = Color3.fromRGB(60, 220, 130), warn = Color3.fromRGB(255, 184, 64), danger = Color3.fromRGB(255, 76, 92),
	}
end
local Themes = {
