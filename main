}

-- Decoy GUI ----------------------------------------------------------
local Decoy = {remotes = {}}
ncRegister({"FireServer", "InvokeServer"}, "decoy", function(self)
	if Decoy.remotes[self] then
		report("Decoy GUI", "Bait remote '" .. self.Name .. "' was fired — something is fuzzing remotes.", 3, "decoyremote")
		return true, {n = 0}
	end
end)
define{
	id = "decoy", module = "extras", name = "Decoy GUI",
	desc = "Plants invisible bait interfaces and remotes. Anything that clicks, fires or tampers with them is flagged.",
	start = function(f, maid)
		local cleaning = false
		maid:Add(function() cleaning = true end)
		local function flag(what) report("Decoy GUI", what, 3, "decoy:" .. what) end
		local function watch(inst, label)
			maid:Add(inst.Destroying:Connect(function() if not cleaning then flag(label .. " was destroyed") end end))
			maid:Add(inst:GetPropertyChangedSignal("Name"):Connect(function() if not cleaning then flag(label .. " was renamed") end end))
		end
		local function makeGui(parent, label)
			local g = New("ScreenGui", {Name = label, ResetOnSpawn = false, DisplayOrder = -50, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = true})
			internalRoots[g] = true
			local fr = New("Frame", {Name = "Panel", Size = UDim2.fromOffset(2, 2), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1, Parent = g})
			for _, bn in ipairs({"Claim", "Teleport", "Execute"}) do
				local b = New("TextButton", {Name = bn, Text = "", Size = UDim2.fromOffset(2, 2), BackgroundTransparency = 1, Parent = fr})
				for _, ev in ipairs({"Activated", "MouseButton1Click", "MouseButton1Down", "MouseButton2Click"}) do
					maid:Add(b[ev]:Connect(function()
						flag(string.format("'%s/%s' fired %s — an external script is clicking UI", label, bn, ev))
					end))
				end
				watch(b, label .. "/" .. bn)
			end
			watch(fr, label .. "/Panel"); watch(g, label)
			g.Parent = parent
			maid:Add(g)
		end
		makeGui(Container, "AdminPanel")
		if PlayerGui ~= Container then makeGui(PlayerGui, "RewardsMenu") end
		local baited = false
		if ReplicatedStorage and Caps.hooks and ncInstall() then
			for _, spec in ipairs({{"RemoteEvent", "AdminCommand"}, {"RemoteFunction", "GetPlayerData"}}) do
				if not ReplicatedStorage:FindFirstChild(spec[2]) then
					local r = New(spec[1], {Name = spec[2]})
					Decoy.remotes[r] = true
					r.Parent = ReplicatedStorage
					maid:Add(function() Decoy.remotes[r] = nil end)
					maid:Add(r)
					watch(r, spec[2])
					baited = true
				end
			end
		end
		if baited then f.status = nil else f.status = "Bait remotes inactive (no hooks)" end
	end,
}

-- Security Scanner ---------------------------------------------------
define{
	id = "scanner", module = "extras", name = "Security Scanner",
	desc = "Periodically checks your environment for suspicious changes: new CoreGui GUIs, speed/jump/gravity tampering, movers on your character.",
	opts = {interval = 15},
	build = function(f, p)
		Ctl.Slider(p, "Scan interval (s)", f.opts, "interval", 5, 60, 5)
		Ctl.Buttons(p, {{"Scan now", function() if f.enabled and f.scanNow then f.scanNow() else notify("Security Scanner", "Enable it first.", "warn") end end}})
	end,
	start = function(f, maid)
		local base = {core = {}, gravity = Workspace.Gravity, ws = nil, jp = nil}
		pcall(function() for _, c in ipairs(CoreGui:GetChildren()) do base.core[c] = true end end)
		local last = {}
		local function scan()
			local n = 0
			local function find(msg, sev, key)
				n = n + 1
				report("Security Scanner", msg, sev, key)
			end
			pcall(function()
				for _, c in ipairs(CoreGui:GetChildren()) do
					if not base.core[c] and not CORE_OK[c.Name] and not isInternal(c) then
						base.core[c] = true
						find("New CoreGui child '" .. c.Name .. "' (" .. c.ClassName .. ")", 2, "scan:core:" .. c.Name)
					end
				end
			end)
			for _, root in ipairs({PlayerGui}) do
				for _, g in ipairs(root:GetChildren()) do
					if g:IsA("LayerCollector") and not isInternal(g) and hubMatch(g.Name) then
						find("Known hub-style GUI '" .. g.Name .. "' present", 3, "scan:hub:" .. g.Name)
					end
				end
			end
			local c = LocalPlayer.Character
			local h = c and c:FindFirstChildOfClass("Humanoid")
			if h then
				if last.ws and h.WalkSpeed ~= last.ws and h.WalkSpeed > 60 then
					find(string.format("WalkSpeed changed %s → %s", fmtNum(last.ws), fmtNum(h.WalkSpeed)), 1, "scan:ws")
				end
				if last.jp and h.JumpPower ~= last.jp and h.JumpPower > 100 then
					find(string.format("JumpPower changed %s → %s", fmtNum(last.jp), fmtNum(h.JumpPower)), 1, "scan:jp")
				end
				last.ws, last.jp = h.WalkSpeed, h.JumpPower
				for _, d in ipairs(c:GetDescendants()) do
					if RISK[d.ClassName] == 1 and not isInternal(d) then
						find(d.ClassName .. " '" .. d.Name .. "' is attached to your character", 3, "scan:mover:" .. d.ClassName)
						break
					end
				end
			end
			if Workspace.Gravity ~= base.gravity then
				find(string.format("Gravity changed %s → %s", fmtNum(base.gravity), fmtNum(Workspace.Gravity)), 1, "scan:grav")
				base.gravity = Workspace.Gravity
			end
			f.status = string.format("Last scan %s · %d finding%s", os.date("%H:%M:%S"), n, n == 1 and "" or "s")
			refreshAll()
			return n
		end
		f.scanNow = function()
			local n = scan()
			notify("Security Scanner", n == 0 and "Clean — nothing suspicious found." or (n .. " finding(s) logged."), n == 0 and "ok" or "warn")
		end
		maid:Add(function() f.scanNow = nil end)
		maid:Add(task.spawn(function()
			task.wait(2)
			while true do
				pcall(scan)
				task.wait(math.max(5, f.opts.interval))
			end
		end))
	end,
}

-- Safe Mode ----------------------------------------------------------
define{
	id = "safemode", module = "extras", name = "Safe Mode",
	desc = "Strips unneeded local interactions and hides chosen interfaces: chat, player list, backpack, prompts and more.",
	opts = {chat = true, playerlist = true, backpack = true, emotes = true, prompts = true, resetBtn = true, hideSelected = true},
	build = function(f, p)
		local r = function() restart(f) end
		Ctl.Toggle(p, "Hide chat", f.opts, "chat", r)
		Ctl.Toggle(p, "Hide player list", f.opts, "playerlist", r)
		Ctl.Toggle(p, "Hide backpack", f.opts, "backpack", r)
		Ctl.Toggle(p, "Hide emotes menu", f.opts, "emotes", r)
		Ctl.Toggle(p, "Disable proximity prompts", f.opts, "prompts", r)
		Ctl.Toggle(p, "Disable reset button", f.opts, "resetBtn", r)
		Ctl.Toggle(p, "Also hide GUI Protector selection", f.opts, "hideSelected", r)
	end,
	start = function(f, maid)
		local o = f.opts
		local map = {chat = "Chat", playerlist = "PlayerList", backpack = "Backpack", emotes = "EmotesMenu"}
		for key, core in pairs(map) do
			if o[key] then
				CoreLock.acquire(core, "safemode")
				maid:Add(function() CoreLock.release(core, "safemode") end)
			end
		end
		if o.prompts and ProximityPromptService then
			local orig = ProximityPromptService.Enabled
			ProximityPromptService.Enabled = false
			maid:Add(function() ProximityPromptService.Enabled = orig end)
		end
		if o.resetBtn then
			pcall(StarterGui.SetCore, StarterGui, "ResetButtonCallback", false)
			maid:Add(function() pcall(StarterGui.SetCore, StarterGui, "ResetButtonCallback", true) end)
		end
		if o.hideSelected then
			local gp = Features.guiprot
			local function sweep()
				for key, on in pairs(gp.opts.hidden) do
					if on == true then
						if key:sub(1, 5) == "core:" then
							CoreLock.acquire(key:sub(6), "safemode")
						else
							for _, g in ipairs(PlayerGui:GetChildren()) do
								if g:IsA("ScreenGui") and g.Name == key and not isInternal(g) then GuiLock.acquire(g, "safemode") end
							end
						end
					end
				end
			end
			sweep()
			maid:Add(function()
				for key in pairs(gp.opts.hidden) do
					if key:sub(1, 5) == "core:" then CoreLock.release(key:sub(6), "safemode") end
				end
				for _, g in ipairs(PlayerGui:GetChildren()) do
					if g:IsA("ScreenGui") then GuiLock.release(g, "safemode") end
				end
			end)
		end
	end,
}

-- Auto-Lockdown ------------------------------------------------------
define{
	id = "lockdown", module = "extras", name = "Auto-Lockdown",
	desc = "Escalates on its own: if several high-severity threats land inside the time window, every protection switches on.",
	opts = {threshold = 3, window = 30},
	build = function(f, p)
		Ctl.Slider(p, "High-severity hits to trigger", f.opts, "threshold", 1, 10, 1)
		Ctl.Slider(p, "Time window (s)", f.opts, "window", 10, 120, 5)
		Ctl.Note(p, "Turns on the Privacy and Exploit Protection modules plus the alarm, log and scanner. Safe Mode is left alone because it hides game UI.")
	end,
	start = function(f, maid)
		local hits = {}
		maid:Add(Threats.listen(function(e)
			if not f.enabled or Emergency.active or e.sev < 3 then return end
			local now = os.clock()
			hits[#hits + 1] = now
			local keep = {}
			for _, t in ipairs(hits) do if now - t <= f.opts.window then keep[#keep + 1] = t end end
			hits = keep
			if #hits < f.opts.threshold then return end
			hits = {}
			local turned = 0
			local function on(id)
				local ft = Features[id]
				if ft and ft.type ~= "action" and not ft.enabled then
					setFeature(id, true, true)
					if ft.enabled then turned = turned + 1 end
				end
			end
			for _, m in ipairs({"privacy", "exploit"}) do
				for _, ft in ipairs(ModuleFeatures[m]) do on(ft.id) end
			end
			for _, id in ipairs({"alarm", "threatlog", "scanner"}) do on(id) end
			f.status = string.format("Last trigger %s - %d protection%s enabled", os.date("%H:%M:%S"), turned, turned == 1 and "" or "s")
			notify("Auto-Lockdown engaged", turned .. " protection(s) switched on after repeated high-severity threats.", "danger", 7)
			refreshAll()
		end))
	end,
}

---------------------------------------------------------------------
-- Configs
---------------------------------------------------------------------
local Cfg = {dir = "Gaia/configs", legacyDir = "Surety/configs"}
genv.GaiaMemConfigs = genv.GaiaMemConfigs or genv.SuretyMemConfigs or {}
-- Keep the former in-memory table as an alias so existing configs survive rebranding.
genv.SuretyMemConfigs = genv.GaiaMemConfigs
Cfg.mem = genv.GaiaMemConfigs

local function sanitize(n) return ((tostring(n or ""):gsub("[^%w_%- ]", "")):sub(1, 32)) end

function Cfg.snapshot()
	local data = {v = 1, settings = {}, features = {}}
	for k, v in pairs(Settings) do data.settings[k] = v end
	for id, f in pairs(Features) do
		data.features[id] = {enabled = f.type ~= "action" and f.enabled or nil, opts = f.opts}
	end
	return data
end

function Cfg.names()
	local out, seen = {}, {}
	if Caps.fs then
		for _, dir in ipairs({Cfg.dir, Cfg.legacyDir}) do
			local ok, files = pcall(Caps.listfiles, dir)
			if ok and type(files) == "table" then
				for _, p in ipairs(files) do
					local n = tostring(p):match("([^/\\]+)%.json$")
					if n and not seen[n] then seen[n] = true; out[#out + 1] = n end
				end
			end
		end
	else
		for n in pairs(Cfg.mem) do out[#out + 1] = n end
	end
	table.sort(out)
	return out
end

function Cfg.save(name)
	name = sanitize(name)
	if name == "" then return false, "Enter a config name first." end
	local ok, json = pcall(HttpService.JSONEncode, HttpService, Cfg.snapshot())
	if not ok then return false, "Could not encode config." end
	if Caps.fs then
		pcall(function()
			if not Caps.isfolder("Gaia") then Caps.makefolder("Gaia") end
			if not Caps.isfolder(Cfg.dir) then Caps.makefolder(Cfg.dir) end
			Caps.writefile(Cfg.dir .. "/" .. name .. ".json", json)
		end)
	else
		Cfg.mem[name] = json
	end
	return true, name
end

function Cfg.read(name)
	name = sanitize(name)
	local json
	if Caps.fs then
		local function readPath(path)
			local ok, exists = pcall(Caps.isfile, path)
			if ok and exists then
				local okr, r = pcall(Caps.readfile, path)
				if okr then return r end
			end
		end
		json = readPath(Cfg.dir .. "/" .. name .. ".json")
			or readPath(Cfg.legacyDir .. "/" .. name .. ".json")
	else
		json = Cfg.mem[name]
	end
	if not json then return nil end
	local ok, data = pcall(HttpService.JSONDecode, HttpService, json)
	if ok and type(data) == "table" then return data end
end

function Cfg.delete(name)
	name = sanitize(name)
	if Caps.fs and Caps.delfile then
		pcall(Caps.delfile, Cfg.dir .. "/" .. name .. ".json")
		pcall(Caps.delfile, Cfg.legacyDir .. "/" .. name .. ".json")
	end
	Cfg.mem[name] = nil
end

function Cfg.apply(data)
	local wasBooting = Booting
	Booting = true
	if type(data.settings) == "table" then
		for k, default in pairs(Settings) do
			local v = data.settings[k]
			if v ~= nil and type(v) == type(default) then Settings[k] = v end
		end
		if not Themes[Settings.theme] then Settings.theme = "Crimson" end
		if not FontSets[Settings.font] then Settings.font = "Code" end
		Settings.scale = math.clamp(Settings.scale, 0.7, 1.3)
		Settings.opacity = math.clamp(Settings.opacity, 0.4, 1)
	end
	if type(data.features) == "table" then
		for id, saved in pairs(data.features) do
			local f = Features[id]
			if f and type(saved) == "table" then
				if type(saved.opts) == "table" then
					for k, v in pairs(saved.opts) do
						if f.opts[k] == nil or type(f.opts[k]) == type(v) then f.opts[k] = v end
					end
				end
				if f.type ~= "action" then
					if f.enabled then setFeature(id, false, true) end
					if saved.enabled == true then setFeature(id, true, true) end
				end
			end
		end
	end
	UI.applyAppearance()
	Booting = wasBooting
	refreshAll()
end

local dirtyTok = 0
function markDirty()
	if Booting or not Settings.autosave then return end
	dirtyTok = dirtyTok + 1
	local mine = dirtyTok
	task.delay(1.5, function()
		if mine == dirtyTok and alive then Cfg.save("default") end
	end)
end

---------------------------------------------------------------------
-- Toasts / alarm / capture
---------------------------------------------------------------------
function notify(title, msg, kind, dur)
	if not alive or not UI.toasts then return end
	if not Settings.notifications and kind ~= "danger" then return end
	local key = kind == "danger" and "danger" or kind == "warn" and "warn" or kind == "ok" and "ok" or "accent"
	local shown = {}
	for _, c in ipairs(UI.toasts:GetChildren()) do if c:IsA("Frame") then shown[#shown + 1] = c end end
	if #shown >= 4 then shown[1]:Destroy() end
	local holder = New("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Y, BackgroundTransparency = 1, Parent = UI.toasts})
	local body = New("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Y, Position = UDim2.new(1, 40, 0, 0), BorderSizePixel = 0, Parent = holder})
	T(body, "BackgroundColor3", "surface"); Corner(body, 8); Stroke(body, key)
	local strip = New("Frame", {Size = UDim2.new(0, 3, 1, -16), Position = UDim2.fromOffset(5, 8), BorderSizePixel = 0, Parent = body})
	T(strip, "BackgroundColor3", key); Corner(strip, 2)
	local inner = New("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Y, BackgroundTransparency = 1, Parent = body})
	Pad(inner, 14, 9, 12, 9); List(inner, 2)
	Label(inner, title, 13, "text", true)
	if msg and msg ~= "" then Label(inner, msg, 12, "sub") end
	TweenService:Create(body, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)}):Play()
	task.delay(dur or Settings.toastTime, function()
		if holder.Parent then
			local t = TweenService:Create(body, TweenInfo.new(0.22), {Position = UDim2.new(1, 40, 0, 0)})
			t:Play()
			t.Completed:Wait()
			holder:Destroy()
		end
	end)
end

function UI.setCaptureHidden(hide)
	if UI.gui then UI.gui.Enabled = not hide end
end

function UI.alarm(opts)
	if opts.flash and UI.flash then
		UI.flash.Transparency = 0.05
		TweenService:Create(UI.flash, TweenInfo.new(1.2), {Transparency = 1}):Play()
	end
	if opts.sound then
		pcall(function()
			for i = 1, 3 do
				local s = New("Sound", {SoundId = "rbxasset://sounds/electronicpingshort.wav", Volume = 1, PlaybackSpeed = 0.8 + i * 0.25, Parent = SoundService})
				s:Play()
				game:GetService("Debris"):AddItem(s, 3)
				task.wait(0.18)
			end
		end)
	end
end

---------------------------------------------------------------------
-- Appearance / layout
---------------------------------------------------------------------
function UI.applyAppearance()
	Theme = Themes[Settings.theme] or Themes.Crimson
	local keep = {}
	for _, e in ipairs(Themed) do
		if e[1].Parent then e[1][e[2]] = Theme[e[3]]; keep[#keep + 1] = e end
	end
	Themed = keep
	local fk = {}
	for _, e in ipairs(FontReg) do
		if e[1].Parent then e[1].Font = FontSets[Settings.font][e[2] and 2 or 1]; fk[#fk + 1] = e end
	end
	FontReg = fk
	local hk = {}
	for _, e in ipairs(ThemeHooks) do
		if e[2].Parent then pcall(e[1]); hk[#hk + 1] = e end
	end
	ThemeHooks = hk
	if UI.win then
		UI.layout()
		if UI.visible then UI.win.GroupTransparency = 1 - Settings.opacity end
	end
end

function UI.layout()
	if not UI.gui then return end
	local vp = UI.gui.AbsoluteSize
	if vp.X < 50 then
		local cam = Workspace.CurrentCamera
		vp = cam and cam.ViewportSize or Vector2.new(800, 600)
	end
	local s = math.max(0.5, math.min(Settings.scale, (vp.X - 12) / 330, (vp.Y - 12) / 300))
	UI.uiscale.Scale = s
	local w, h = math.min(560, (vp.X - 12) / s), math.min(430, (vp.Y - 12) / s)
	UI.win.Size = UDim2.fromOffset(w, h)
	UI.pill.Visible = w >= 440
	local tw = math.min(320, vp.X - 24)
	UI.toasts.Size = UDim2.fromOffset(tw, 0)
	if vp.X < 720 then
		UI.toasts.AnchorPoint = Vector2.new(0.5, 0); UI.toasts.Position = UDim2.new(0.5, 0, 0, 62)
	else
		UI.toasts.AnchorPoint = Vector2.new(1, 0); UI.toasts.Position = UDim2.new(1, -14, 0, 62)
	end
end

function UI.setVisible(v)
	UI.visible = v
	local target = 1 - Settings.opacity
	if v then
		UI.win.Visible = true
		UI.win.GroupTransparency = 1
		TweenService:Create(UI.win, TweenInfo.new(0.18), {GroupTransparency = target}):Play()
		UI.fab.Visible = false
	else
		TweenService:Create(UI.win, TweenInfo.new(0.14), {GroupTransparency = 1}):Play()
		task.delay(0.15, function() if not UI.visible and UI.win then UI.win.Visible = false end end)
		UI.fab.Visible = Settings.showButton or TOUCH
	end
end

local function makeDraggable(handle, target, onTap)
	local dragging, dragInput, startIn, startPos, moved = false, nil, nil, nil, false
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging, moved = true, false
			startIn, startPos = input.Position, target.Position
			local c
			c = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					c:Disconnect()
					if not moved and onTap then onTap() end
				end
			end)
		end
	end)
	handle.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
	end)
	Core.maid:Add(UIS.InputChanged:Connect(function(input)
		if dragging and input == dragInput then
			local d = input.Position - startIn
			if d.Magnitude > 6 then moved = true end
			if moved or not onTap then
				local vp = UI.gui.AbsoluteSize
				target.Position = UDim2.fromScale(
					math.clamp(startPos.X.Scale + d.X / vp.X, 0.03, 0.97),
					math.clamp(startPos.Y.Scale + d.Y / vp.Y, 0.03, 0.97))
			end
		end
	end))
end

