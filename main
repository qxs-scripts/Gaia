-- Intrusion Alarm ----------------------------------------------------
define{
	id = "alarm", module = "extras", name = "Intrusion Alarm",
	desc = "Sounds a pulse and flashes the screen edge when a threat at or above your chosen level is detected.",
	opts = {minSev = "Medium", sound = true, flash = true},
	build = function(f, p)
		Ctl.Segment(p, "Minimum severity", f.opts, "minSev", {"Low", "Medium", "High"})
		Ctl.Toggle(p, "Alarm sound", f.opts, "sound")
		Ctl.Toggle(p, "Screen flash", f.opts, "flash")
		Ctl.Buttons(p, {{"Test alarm", function() UI.alarm(f.opts) end}})
	end,
	start = function(f, maid)
		local order = {Low = 1, Medium = 2, High = 3}
		maid:Add(Threats.listen(function(e)
			if f.enabled and e.sev >= (order[f.opts.minSev] or 2) then UI.alarm(f.opts) end
		end))
	end,
}

