	id = "shutdown", module = "extras", name = "Emergency Shutdown", type = "action",
	desc = "Instantly switches off every optional Gaia feature. Restore brings them back.",
	opts = {keepLog = true},
	build = function(f, p)
		Ctl.Toggle(p, "Keep Threat Log recording", f.opts, "keepLog")
	end,
	run = function()
		if Emergency.active then emergencyRestore() else emergencyShutdown() end
	end,
}

