local function newPage(parent)
	local page = New("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
		AutomaticCanvasSize = Y, CanvasSize = UDim2.new(), ScrollingDirection = Enum.ScrollingDirection.Y,
		ElasticBehavior = Enum.ElasticBehavior.WhenScrollable, Visible = false, Parent = parent,
	})
	T(page, "ScrollBarImageColor3", "accent")
	Pad(page, 12, 12, 12, 16); List(page, 10)
	return page
end

-- Home ---------------------------------------------------------------
local function buildHome(page)
	Ctl.scroller = page
	local hero = Card(page)
	hero:FindFirstChildOfClass("UIListLayout").HorizontalAlignment = Enum.HorizontalAlignment.Center
	local lg, lgAnim = Logo.create(hero, 96)
	Core.maid:Add(RunService.RenderStepped:Connect(function()
		if UI.visible and UI.tab == "Home" then lgAnim.Rotation = (os.clock() * 40) % 360 end
	end))
	local nm = Label(hero, "GAIA", 26, "text", true, {TextXAlignment = CENTER, TextColor3 = Color3.new(1, 1, 1), AutomaticSize = Y})
	Themed[#Themed] = nil -- keep white so the gradient owns the colour
	Grad(nm, 0)
	Label(hero, "Privacy & Security Suite  ·  v" .. VERSION, 12, "sub", false, {TextXAlignment = CENTER})

	local prot = Card(page, "PROTECTION")
	local status = Label(prot, "IDLE", 22, "sub", true)
	local detail = Label(prot, "", 12, "sub")
	local track = New("Frame", {Size = UDim2.new(1, 0, 0, 6), BorderSizePixel = 0, Parent = prot})
	T(track, "BackgroundColor3", "raised"); Corner(track, 3)
	local fill = New("Frame", {Size = UDim2.fromScale(0, 1), BorderSizePixel = 0, Parent = track})
	T(fill, "BackgroundColor3", "accent"); Corner(fill, 3)

	-- Security Score (feature) --------------------------------------
	local SCORE_W = {antiss = 10, identity = 10, logger = 12, guidetect = 10, remotes = 12, charprot = 12, instances = 10, alarm = 8, threatlog = 6, scanner = 10}
	local sc = Card(page, "SECURITY SCORE")
	local scTop = New("Frame", {Size = UDim2.new(1, 0, 0, 56), BackgroundTransparency = 1, Parent = sc})
	local scGrade = Label(scTop, "-", 40, "sub", true, {Size = UDim2.fromOffset(52, 56), AutomaticSize = Enum.AutomaticSize.None, TextYAlignment = Enum.TextYAlignment.Center, TextXAlignment = CENTER})
	local scNum = Label(scTop, "0 / 100", 16, "text", true, {Size = UDim2.new(1, -66, 0, 24), Position = UDim2.fromOffset(66, 4), AutomaticSize = Enum.AutomaticSize.None})
	local scNote = Label(scTop, "", 11, "sub", false, {Size = UDim2.new(1, -66, 0, 28), Position = UDim2.fromOffset(66, 28), AutomaticSize = Enum.AutomaticSize.None})
	local scTrack = New("Frame", {Size = UDim2.new(1, 0, 0, 6), BorderSizePixel = 0, Parent = sc})
	T(scTrack, "BackgroundColor3", "raised"); Corner(scTrack, 3)
	local scFill = New("Frame", {Size = UDim2.fromScale(0, 1), BorderSizePixel = 0, Parent = scTrack})
	T(scFill, "BackgroundColor3", "accent"); Corner(scFill, 3)
	local scRecs = New("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Y, BackgroundTransparency = 1, Parent = sc})
	List(scRecs, 6)

	local function scoreUpdate()
		local got, max, todo = 0, 0, {}
		for id, w in pairs(SCORE_W) do
			local f = Features[id]
			if f then
				local sup = true
				if f.supported then
					local okc, r = pcall(f.supported)
					sup = okc and r and true or false
				end
				if sup then
					max = max + w
					if f.enabled then got = got + w else todo[#todo + 1] = {f = f, w = w} end
				end
			end
		end
		local score = max > 0 and math.floor(got / max * 100 + 0.5) or 0
		local letter, key, note = "F", "danger", "Mostly unprotected."
		if score >= 90 then letter, key, note = "A", "ok", "Excellent coverage."
		elseif score >= 75 then letter, key, note = "B", "ok", "Strong, with a few gaps."
		elseif score >= 55 then letter, key, note = "C", "warn", "Decent, but exposed in places."
		elseif score >= 30 then letter, key, note = "D", "warn", "Thin protection." end
		if Emergency.active then letter, key, note = "-", "danger", "Emergency shutdown is active." end
		scGrade.Text = letter; scGrade.TextColor3 = Theme[key]
		scNum.Text = score .. " / 100"
		scNote.Text = note
		scFill.BackgroundColor3 = Theme[key]
		TweenService:Create(scFill, TweenInfo.new(0.25), {Size = UDim2.fromScale(score / 100, 1)}):Play()
		for _, c in ipairs(scRecs:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
		table.sort(todo, function(x, y) if x.w ~= y.w then return x.w > y.w end return x.f.name < y.f.name end)
		if #todo == 0 then
			Label(scRecs, "Every recommended protection is active.", 11, "ok")
		else
			Label(scRecs, "BIGGEST GAPS", 10, "sub", true)
			for i = 1, math.min(3, #todo) do
				local f = todo[i].f
				local r = New("Frame", {Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, Parent = scRecs})
				Label(r, f.name .. "  +" .. todo[i].w, 12, "text", false, {Size = UDim2.new(1, -78, 1, 0), AutomaticSize = Enum.AutomaticSize.None, TextYAlignment = Enum.TextYAlignment.Center})
				Btn(r, "Enable", "primary", function() setFeature(f.id, true) end, {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(0, 26)})
			end
		end
	end

	local exec = Card(page, "EXECUTOR")
	Label(exec, ExecName, 16, "text", true)
	if ExecVersion then Label(exec, "Version " .. ExecVersion, 11, "sub") end
	local chips = New("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Y, BackgroundTransparency = 1, Parent = exec})
	local cl = List(chips, 6, HORIZ); cl.Wraps = true
	Chip(chips, "Hooks", Caps.hooks)
	Chip(chips, "HTTP guard", (#RequestFns > 0 and Caps.hookfunction) and true or false)
	Chip(chips, "Config files", Caps.fs)
	Chip(chips, "Clipboard", Caps.setclipboard and true or false)
	Chip(chips, TOUCH and "Mobile UI" or "Desktop UI", true)

	local mods = Card(page, "ACTIVE MODULES")
	local modBody = New("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Y, BackgroundTransparency = 1, Parent = mods})
	List(modBody, 10)

	local sess = Card(page, "SESSION")
	local grid = New("Frame", {Size = UDim2.new(1, 0, 0, 52), BackgroundTransparency = 1, Parent = sess})
	local gl = List(grid, 8, HORIZ)
	local function stat(name)
		local b = New("Frame", {Size = UDim2.new(1 / 3, -6, 1, 0), BorderSizePixel = 0, Parent = grid})
		T(b, "BackgroundColor3", "raised"); Corner(b, 6); Pad(b, 10, 6)
		local v = Label(b, "0", 18, "text", true, {AutomaticSize = Enum.AutomaticSize.None, Size = UDim2.new(1, 0, 0, 22)})
		Label(b, name, 10, "sub", false, {AutomaticSize = Enum.AutomaticSize.None, Size = UDim2.new(1, 0, 0, 12), Position = UDim2.new(0, 0, 0, 24)})
		return v
	end
	local sThreats, sHigh, sUp = stat("THREATS"), stat("HIGH SEVERITY"), stat("UPTIME")
	local lastLbl = Label(sess, "No threats detected this session.", 11, "sub")

	local qa = Card(page, "QUICK ACTIONS")
	Ctl.Buttons(qa, {
		{"Enable recommended", function()
			for _, id in ipairs(RECOMMENDED) do setFeature(id, true, true) end
			notify("Recommended set enabled", "Core privacy and protection features are on.", "ok")
		end, "primary"},
		{"Open Modules", function() UI.setTab("Modules") end},
	})

	function UI.refreshHome()
		local on, total, per = counts()
		local ratio = total > 0 and on / total or 0
		local txt, key = "IDLE", "sub"
		if Emergency.active then txt, key = "SHUTDOWN", "danger"
		elseif on > 0 then
			if ratio >= 0.5 then txt, key = "SECURED", "ok" else txt, key = "PARTIAL", "warn" end
		end
		status.Text = txt; status.TextColor3 = Theme[key]
		detail.Text = string.format("%d of %d features active", on, total)
		fill.BackgroundColor3 = Theme[key == "sub" and "accent" or key]
		TweenService:Create(fill, TweenInfo.new(0.25), {Size = UDim2.fromScale(ratio, 1)}):Play()
		UI.statusText, UI.statusKey = txt, key
		for _, c in ipairs(modBody:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
		for _, m in ipairs(ModuleList) do
			local row = New("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Y, BackgroundTransparency = 1, Parent = modBody})
			List(row, 6)
			local hd = New("Frame", {Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, Parent = row})
			local a, t = per[m.id][1], per[m.id][2]
			local dot = New("Frame", {Size = UDim2.fromOffset(8, 8), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), BackgroundColor3 = a > 0 and Theme.ok or Theme.line, BorderSizePixel = 0, Parent = hd})
			Corner(dot, 4)
			Label(hd, m.name, 13, "text", true, {Size = UDim2.new(1, -90, 1, 0), Position = UDim2.fromOffset(18, 0), AutomaticSize = Enum.AutomaticSize.None, TextYAlignment = Enum.TextYAlignment.Center})
			Label(hd, a .. "/" .. t .. " active", 11, a > 0 and "ok" or "sub", false, {Size = UDim2.new(0, 80, 1, 0), Position = UDim2.new(1, -80, 0, 0), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = RIGHT, TextYAlignment = Enum.TextYAlignment.Center})
			local cw = New("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Y, BackgroundTransparency = 1, Parent = row})
			local l2 = List(cw, 6, HORIZ); l2.Wraps = true
			local any = false
			for _, f in ipairs(ModuleFeatures[m.id]) do
				if f.enabled then any = true; Chip(cw, f.name) end
			end
			if not any then Label(cw, "Nothing active", 11, "sub") end
		end
		pcall(scoreUpdate)
		sThreats.Text = tostring(Threats.total)
		sHigh.Text = tostring(Threats.counts[3])
		local last = Threats.last
		if last then
			lastLbl.Text = string.format("Last: [%s] %s — %s", os.date("%H:%M:%S", last.t), last.source, last.desc)
		end
	end
	task.spawn(function()
		while alive do
			task.wait(1)
			local s = math.floor(os.clock() - bootClock)
			sUp.Text = string.format("%d:%02d:%02d", s // 3600, (s // 60) % 60, s % 60)
		end
	end)
end

-- Modules ------------------------------------------------------------
local function bulk(on)
	for _, m in ipairs(ModuleList) do
		for _, f in ipairs(ModuleFeatures[m.id]) do
			if f.type ~= "action" then setFeature(f.id, on, true) end
		end
	end
	notify(on and "All features enabled" or "All features disabled", "", on and "ok" or "info", 2.5)
end

local function featureRow(parent, f, page)
	local row = New("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Y, BackgroundTransparency = 1, Parent = parent})
	List(row, 8)
	local top = New("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Y, BackgroundTransparency = 1, Parent = row})
	local info = New("Frame", {Size = UDim2.new(1, -108, 0, 0), AutomaticSize = Y, BackgroundTransparency = 1, Parent = top})
	List(info, 2)
	Label(info, f.name, 13, "text", true)
	Label(info, f.desc, 11, "sub")
	local st = Label(info, "", 11, "accent")
	local ctrl = New("Frame", {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(0, 30), AutomaticSize = X, BackgroundTransparency = 1, Parent = top})
	List(ctrl, 8, HORIZ, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)

	local panel, built
	if f.build then
		local gear = New("TextButton", {Text = "···", TextSize = 16, AutoButtonColor = false, Size = UDim2.fromOffset(30, 28), BorderSizePixel = 0, LayoutOrder = 1, Parent = ctrl})
		T(gear, "BackgroundColor3", "raised"); T(gear, "TextColor3", "sub"); F(gear, true); Corner(gear, 6)
		panel = New("Frame", {Visible = false, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Y, BorderSizePixel = 0, Parent = row})
		T(panel, "BackgroundColor3", "raised"); Corner(panel, 6); Pad(panel, 10); List(panel, 8)
		gear.Activated:Connect(function()
			if not built then
				built = true
				Ctl.scroller = page
				f.build(f, panel)
			end
			panel.Visible = not panel.Visible
			gear.TextColor3 = panel.Visible and Theme.accent or Theme.sub
		end)
	end
	if f.type == "action" then
		local b = Btn(ctrl, "RUN", "danger", function() f.run(f); refreshAll() end, {LayoutOrder = 2})
		addRefresh(function() b.Text = Emergency.active and "RESTORE" or "ACTIVATE" end, b)
	else
		local sw = Switch(ctrl, function() return f.enabled end, function() setFeature(f.id, not f.enabled) end)
		sw.LayoutOrder = 2
	end
	addRefresh(function()
		local txt = f.status or ""
		st.TextColor3 = Theme.accent
		if f.supported and f.type ~= "action" then
			local ok, why = f.supported()
			if not ok then
				txt = why or "Unsupported on this executor"
				st.TextColor3 = Theme.danger
			end
		end
		st.Text = txt; st.Visible = txt ~= ""
	end, st)
	return row
end

local function buildModules(page)
	Ctl.scroller = page
	local top = Card(page, "QUICK CONTROL")
	Ctl.Buttons(top, {
		{"Turn on all", function() bulk(true) end, "primary"},
		{"Turn off all", function() bulk(false) end},
		{"Recommended", function()
			for _, id in ipairs(RECOMMENDED) do setFeature(id, true, true) end
			notify("Recommended set enabled", "", "ok", 2.5)
		end},
	})
	Ctl.Note(top, "Turn everything on at once, or pick individual features below. Tap ··· on a row for its options.")
	for _, m in ipairs(ModuleList) do
		local card = Card(page)
		local hd = New("Frame", {Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, Parent = card})
		local ttl = Label(hd, string.upper(m.name), 13, "accent", true, {Size = UDim2.new(1, -110, 0, 18), AutomaticSize = Enum.AutomaticSize.None})
		local cnt = Label(hd, "", 11, "sub", false, {Size = UDim2.new(1, -110, 0, 14), Position = UDim2.fromOffset(0, 18), AutomaticSize = Enum.AutomaticSize.None})
		local allBtn = Btn(hd, "All on", nil, function()
			local _, _, per = counts()
			local on = per[m.id][1] < per[m.id][2]
			for _, f in ipairs(ModuleFeatures[m.id]) do if f.type ~= "action" then setFeature(f.id, on, true) end end
		end, {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(0, 28)})
		addRefresh(function()
			local _, _, per = counts()
			cnt.Text = per[m.id][1] .. " of " .. per[m.id][2] .. " active"
			allBtn.Text = per[m.id][1] < per[m.id][2] and "All on" or "All off"
		end, hd)
		for i, f in ipairs(ModuleFeatures[m.id]) do
			Divider(card)
			featureRow(card, f, page)
		end
	end
end

-- Settings -----------------------------------------------------------
local function buildSettings(page)
	Ctl.scroller = page
	local ap = Card(page, "APPEARANCE")
	Ctl.Segment(ap, "Theme", Settings, "theme", ThemeOrder, function() UI.applyAppearance(); refreshAll() end, function(n) return Themes[n].accent end)
	Ctl.Segment(ap, "Font", Settings, "font", FontOrder, function() UI.applyAppearance() end)
	Ctl.Slider(ap, "UI size", Settings, "scale", 0.7, 1.3, 0.05, fmtPct, function() UI.layout() end)
	Ctl.Slider(ap, "UI opacity", Settings, "opacity", 0.4, 1, 0.05, fmtPct, function() if UI.visible then UI.win.GroupTransparency = 1 - Settings.opacity end end)

	local gn = Card(page, "INTERFACE")
	Ctl.Toggle(gn, "Notifications", Settings, "notifications")
	Ctl.Slider(gn, "Notification time (s)", Settings, "toastTime", 2, 10, 1)
	Ctl.Toggle(gn, "Floating logo button (always on for touch)", Settings, "showButton", function() if not UI.visible then UI.fab.Visible = Settings.showButton or TOUCH end end)
	Ctl.Toggle(gn, "Auto-save changes to \"default\" config", Settings, "autosave")
	Ctl.Buttons(gn, {{"Reset window position", function()
		UI.win.Position = UDim2.fromScale(0.5, 0.5)
		UI.fab.Position = UDim2.fromScale(0.06, 0.4)
	end}})

	local cf = Card(page, "CONFIGS")
	local state = {name = "", paste = ""}
	Ctl.Text(cf, "Config name", state, "name", "my-setup")
	local listBox = New("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Y, BackgroundTransparency = 1, Parent = cf})
	List(listBox, 4)
	local function renderList()
		for _, c in ipairs(listBox:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
		local names = Cfg.names()
		if #names == 0 then Label(listBox, "No saved configs yet.", 11, "sub") end
		for _, n in ipairs(names) do
			local r = New("Frame", {Size = UDim2.new(1, 0, 0, TOUCH and 38 or 32), BackgroundTransparency = 1, Parent = listBox})
			local nb = New("TextButton", {Text = n, TextSize = 12, AutoButtonColor = false, TextXAlignment = LEFT, Size = UDim2.new(1, -130, 1, 0), BorderSizePixel = 0, Parent = r})
			T(nb, "BackgroundColor3", "raised"); T(nb, "TextColor3", "text"); F(nb, false); Corner(nb, 6); Pad(nb, 10, 0)
			nb.Activated:Connect(function() state.name = n; refreshAll() end)
			local lb = Btn(r, "Load", "primary", function()
				local d = Cfg.read(n)
				if d then Cfg.apply(d); notify("Config loaded", n, "ok", 2.5) else notify("Config", "Could not read " .. n, "danger") end
			end, {AutomaticSize = Enum.AutomaticSize.None, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -64, 0, 0), Size = UDim2.fromOffset(56, r.Size.Y.Offset)})
			Btn(r, "Del", "danger", function() Cfg.delete(n); renderList() end, {AutomaticSize = Enum.AutomaticSize.None, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(56, r.Size.Y.Offset)})
		end
	end
	renderList()
	Ctl.Buttons(cf, {
		{"Save", function()
			local ok, res = Cfg.save(state.name)
			if ok then notify("Config saved", res, "ok", 2.5); renderList() else notify("Config", res, "warn") end
		end, "primary"},
		{"Refresh", renderList},
		{"Copy JSON", function()
			if not Caps.setclipboard then notify("Config", "Executor has no clipboard support.", "warn") return end
			local ok, json = pcall(HttpService.JSONEncode, HttpService, Cfg.snapshot())
			if ok then Caps.setclipboard(json); notify("Config copied", "JSON is on your clipboard.", "ok", 2.5) end
		end},
		{"Reset all", function()
			for _, f in pairs(Features) do
				if f.enabled then setFeature(f.id, false, true) end
				f.opts = deepcopy(f.defaults)
			end
			Settings.theme, Settings.font, Settings.scale, Settings.opacity = "Crimson", "Code", 1, 1
			UI.applyAppearance(); refreshAll()
			notify("Reset", "Everything is back to defaults.", "info")
		end, "danger"},
	})
	Ctl.Text(cf, "Import (paste config JSON)", state, "paste", "{ ... }", function(v)
		if v == "" then return end
		local ok, d = pcall(HttpService.JSONDecode, HttpService, v)
		if ok and type(d) == "table" then Cfg.apply(d); notify("Config imported", "", "ok", 2.5) else notify("Import failed", "That is not valid config JSON.", "danger") end
		state.paste = ""; refreshAll()
	end)
	Ctl.Note(cf, Caps.fs and "Saved to your executor's workspace folder: Gaia/configs" or "Your executor has no file access — configs are kept in memory until you close Roblox.")

	local ab = Card(page, "ABOUT")
	Label(ab, "Gaia v" .. VERSION .. " — client-side privacy and security. It reduces exposure on your device; it cannot change what the server or other players already know.", 11, "sub")
	Ctl.Buttons(ab, {{"Unload Gaia", function() UI.unload() end, "danger"}})
end

---------------------------------------------------------------------
-- Threat log modal
---------------------------------------------------------------------
function UI.openLog()
	if UI.logModal then UI.logModal:Destroy(); UI.logModal = nil end
	local overlay = New("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, BorderSizePixel = 0, Active = true, ZIndex = 50, Parent = UI.win})
	UI.logModal = overlay
	local panel = New("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, -24, 1, -24), BorderSizePixel = 0, ZIndex = 51, Parent = overlay})
	T(panel, "BackgroundColor3", "surface"); Corner(panel, 8); Stroke(panel, "line"); Pad(panel, 12)
	local lay = List(panel, 8)
	Label(panel, "THREAT LOG", 13, "accent", true, {ZIndex = 52})
	local scroll = New("ScrollingFrame", {Size = UDim2.new(1, 0, 1, -82), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, AutomaticCanvasSize = Y, CanvasSize = UDim2.new(), ZIndex = 52, Parent = panel})
	T(scroll, "ScrollBarImageColor3", "accent"); List(scroll, 8)
	local function render()
		for _, c in ipairs(scroll:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
		if #Threats.entries == 0 then
			Label(scroll, Features.threatlog.enabled and "Nothing logged yet." or "Threat Log is off — enable it in Extras to record detections.", 12, "sub", false, {ZIndex = 53})
		end
		for i = 1, math.min(#Threats.entries, 80) do
			local e = Threats.entries[i]
			local l = Label(scroll, string.format('<font color="#%s">%s</font>  <b>%s</b>  <font color="#%s">%s</font>\n%s',
				Theme.sub:ToHex(), os.date("%H:%M:%S", e.t), escapeRich(e.source), Theme[SEV_KEY[e.sev]]:ToHex(), SEV_NAME[e.sev], escapeRich(e.desc)),
				12, "text", false, {RichText = true, ZIndex = 53})
		end
	end
	render()
	local unlisten = Threats.listen(function() if overlay.Parent then render() end end)
	overlay.Destroying:Connect(unlisten)
	local row = Ctl.Buttons(panel, {
		{"Copy", function()
			if not Caps.setclipboard then notify("Threat Log", "No clipboard support on this executor.", "warn") return end
			local out = {}
			for _, e in ipairs(Threats.entries) do out[#out + 1] = string.format("[%s] %s %s: %s", os.date("%H:%M:%S", e.t), SEV_NAME[e.sev], e.source, e.desc) end
			Caps.setclipboard(table.concat(out, "\n"))
			notify("Threat Log", "Copied to clipboard.", "ok", 2)
		end},
		{"Export", function()
			if not Caps.fs then notify("Threat Log", "No file access on this executor.", "warn") return end
			local out = {}
			for _, e in ipairs(Threats.entries) do out[#out + 1] = string.format("[%s] %s %s: %s", os.date("%Y-%m-%d %H:%M:%S", e.t), SEV_NAME[e.sev], e.source, e.desc) end
			pcall(function()
				if not Caps.isfolder("Gaia") then Caps.makefolder("Gaia") end
				Caps.writefile("Gaia/threatlog.txt", table.concat(out, "\n"))
			end)
			notify("Threat Log", "Saved to Gaia/threatlog.txt", "ok", 2.5)
		end},
		{"Clear", function() Threats.entries = {}; render() end},
		{"Close", function() overlay:Destroy(); UI.logModal = nil end, "primary"},
	})
	for _, d in ipairs(row:GetDescendants()) do if d:IsA("GuiObject") then d.ZIndex = 53 end end
	row.ZIndex = 52
end

---------------------------------------------------------------------
-- Unload
---------------------------------------------------------------------
function UI.unload()
	if not alive then return end
	for id, f in pairs(Features) do
		if f.type ~= "action" and f.enabled then pcall(setFeature, id, false, true) end
	end
	if Settings.autosave then pcall(Cfg.save, "default") end
	alive = false
	for gui in pairs(GuiLock.map) do pcall(GuiLock.release, gui, "x") end
	Core.maid:Clean()
	if UI.gui then pcall(UI.gui.Destroy, UI.gui) end
	genv.GaiaLoaded = nil
	genv.GaiaUnload = nil
	genv.SuretyLoaded = nil
	genv.SuretyUnload = nil
end

---------------------------------------------------------------------
-- Window construction
---------------------------------------------------------------------
local function buildShell()
	local gui = New("ScreenGui", {
		Name = HttpService:GenerateGUID(false), ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 999999, IgnoreGuiInset = true,
	})
	protect(gui)
	gui.Parent = Container
	internalRoots[gui] = true
	UI.gui = gui

	local win = New("CanvasGroup", {
		Name = "Window", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(560, 420), BorderSizePixel = 0, Visible = false, GroupTransparency = 1, Active = true, Parent = gui,
	})
	T(win, "BackgroundColor3", "bg"); Corner(win, 12); Stroke(win, "line")
	UI.win = win
	UI.uiscale = New("UIScale", {Parent = win})
	local topbar = New("Frame", {Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 5, Active = false, Parent = win})
	Grad(topbar, 0)

	-- toasts, alarm flash, floating button
	UI.toasts = New("Frame", {Name = "Toasts", BackgroundTransparency = 1, Size = UDim2.fromOffset(300, 0), AutomaticSize = Y, Parent = gui})
	List(UI.toasts, 8)
	local flashFrame = New("Frame", {Name = "Flash", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Active = false, Parent = gui})
	UI.flash = New("UIStroke", {Thickness = 8, Transparency = 1, Color = Theme.danger, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = flashFrame})
	T(UI.flash, "Color", "danger")

	local fab = New("Frame", {Name = "Fab", Size = UDim2.fromOffset(52, 52), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.06, 0.4), BackgroundTransparency = 1, Visible = false, Active = true, Parent = gui})
	Logo.create(fab, 52)
	UI.fab = fab
	makeDraggable(fab, fab, function() UI.setVisible(true) end)

	-- title bar
	local title = New("Frame", {Name = "Title", Size = UDim2.new(1, 0, 0, 48), BackgroundTransparency = 1, Active = true, Parent = win})
	local lg = Logo.create(title, 32)
	lg.Position = UDim2.fromOffset(12, 8)
	lg.Active = false
	Label(title, "GAIA", 16, "text", true, {Size = UDim2.fromOffset(110, 20), Position = UDim2.fromOffset(52, 7), AutomaticSize = Enum.AutomaticSize.None})
	Label(title, "PRIVACY & SECURITY", 9, "sub", false, {Size = UDim2.fromOffset(130, 12), Position = UDim2.fromOffset(52, 27), AutomaticSize = Enum.AutomaticSize.None})
	makeDraggable(title, win)

	local right = New("Frame", {Size = UDim2.new(0, 0, 1, 0), AutomaticSize = X, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 0), BackgroundTransparency = 1, Parent = title})
	List(right, 6, HORIZ, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
	local pill = New("Frame", {Size = UDim2.fromOffset(0, 24), AutomaticSize = X, BorderSizePixel = 0, LayoutOrder = 1, Parent = right})
	T(pill, "BackgroundColor3", "raised"); Corner(pill, 12); Pad(pill, 22, 0, 12, 0)
	local pdot = New("Frame", {Size = UDim2.fromOffset(8, 8), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, -14, 0.5, 0), BorderSizePixel = 0, Parent = pill})
	Corner(pdot, 4)
	local plabel = New("TextLabel", {BackgroundTransparency = 1, Text = "IDLE", TextSize = 10, AutomaticSize = X, Size = UDim2.fromOffset(0, 24), Parent = pill})
	F(plabel, true)
	UI.pill = pill
	addRefresh(function()
		plabel.Text = UI.statusText or "IDLE"
		local c = Theme[UI.statusKey or "sub"]
		plabel.TextColor3 = c; pdot.BackgroundColor3 = c
	end, pill)

	local function iconBtn(icon, key, order, fn)
		local b = New("TextButton", {Text = "", AutoButtonColor = false, Size = UDim2.fromOffset(32, 32), BorderSizePixel = 0, LayoutOrder = order, Parent = right})
		T(b, "BackgroundColor3", "raised"); Corner(b, 8); Stroke(b, "line", 1, 0.5)
		local ic = Icon.create(b, icon, 18)
		ic.root.AnchorPoint = Vector2.new(0.5, 0.5); ic.root.Position = UDim2.fromScale(0.5, 0.5)
		local cur = key
		local function paint() ic.set(Theme[cur]) end
		addRefresh(paint, b)
		b.MouseEnter:Connect(function() TweenService:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = Theme.line}):Play() end)
		b.MouseLeave:Connect(function() TweenService:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = Theme.raised}):Play() end)
		b.Activated:Connect(function() fn(b) end)
		return b, function(k2) cur = k2; paint() end
	end
	iconBtn("alert", "danger", 2, function() if Emergency.active then emergencyRestore() else emergencyShutdown() end end)
	iconBtn("minimize", "text", 3, function() UI.setVisible(false) end)
	local closeBtn, setCloseKey
	closeBtn, setCloseKey = iconBtn("close", "text", 4, function()
		if closeBtn:GetAttribute("armed") then UI.unload() return end
		closeBtn:SetAttribute("armed", true)
		setCloseKey("danger")
		notify("Unload Gaia?", "Tap the close icon again to unload.", "warn", 2.5)
		task.delay(2.5, function()
			if closeBtn.Parent then closeBtn:SetAttribute("armed", nil); setCloseKey("text") end
		end)
	end)

	-- tab bar
	local tabbar = New("Frame", {Name = "Tabs", Position = UDim2.fromOffset(0, 48), Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1, Parent = win})
	local sep = New("Frame", {Position = UDim2.new(0, 0, 1, -1), Size = UDim2.new(1, 0, 0, 1), BorderSizePixel = 0, Parent = tabbar})
	T(sep, "BackgroundColor3", "line")
	local ind = New("Frame", {Size = UDim2.new(1 / 3, -32, 0, 2), Position = UDim2.new(0, 16, 1, -2), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 2, Parent = tabbar})
	Corner(ind, 1); Grad(ind, 0)
	local names = {"Home", "Modules", "Settings"}
	local tabIcons = {Home = "home", Modules = "grid", Settings = "sliders"}
	local tabParts = {}
	local function paintTabs(hover)
		for name, e in pairs(tabParts) do
			local active = name == UI.tab
			e.ic.set(active and Theme.accent or (name == hover and Theme.text or Theme.sub))
			e.lb.TextColor3 = active and Theme.text or (name == hover and Theme.text or Theme.sub)
		end
	end
	for i, n in ipairs(names) do
		local b = New("TextButton", {Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(1 / 3, 0, 1, 0), Position = UDim2.new((i - 1) / 3, 0, 0, 0), Parent = tabbar})
		local holder = New("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(0, 20), AutomaticSize = X, BackgroundTransparency = 1, Parent = b})
		List(holder, 7, HORIZ, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
		local ic = Icon.create(holder, tabIcons[n], 16)
		ic.root.LayoutOrder = 1
		local lb = New("TextLabel", {BackgroundTransparency = 1, Text = n, TextSize = 13, AutomaticSize = X, Size = UDim2.fromOffset(0, 20), LayoutOrder = 2, Parent = holder})
		F(lb, true)
		tabParts[n] = {ic = ic, lb = lb}
		b.Activated:Connect(function() UI.setTab(n) end)
		b.MouseEnter:Connect(function() paintTabs(n) end)
		b.MouseLeave:Connect(function() paintTabs(nil) end)
	end

	local pages = New("Frame", {Position = UDim2.fromOffset(0, 86), Size = UDim2.new(1, 0, 1, -86), BackgroundTransparency = 1, ClipsDescendants = true, Parent = win})
	UI.pages = {}
	for _, n in ipairs(names) do UI.pages[n] = newPage(pages) end

	function UI.setTab(n)
		UI.tab = n
		for name, p in pairs(UI.pages) do p.Visible = (name == n) end
		paintTabs(nil)
		local idx = table.find(names, n) - 1
		TweenService:Create(ind, TweenInfo.new(0.22, Enum.EasingStyle.Quad), {Position = UDim2.new(idx / 3, 16, 1, -2)}):Play()
	end
	addRefresh(function() paintTabs(nil) end, tabbar)

	buildHome(UI.pages.Home)
	buildModules(UI.pages.Modules)
	buildSettings(UI.pages.Settings)
end

function refreshAll()
	if not alive or not UI.gui then return end
	if UI.refreshHome then pcall(UI.refreshHome) end
	local keep = {}
	for _, r in ipairs(Refreshers) do
		if not r[2] or r[2]:IsDescendantOf(UI.gui) then pcall(r[1]); keep[#keep + 1] = r end
	end
	Refreshers = keep
end

---------------------------------------------------------------------
-- Boot
---------------------------------------------------------------------
buildShell()
UI.applyAppearance()
UI.layout()
UI.setTab("Home")

Core.maid:Add(UI.gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(UI.layout))
Core.maid:Add(UIS.InputBegan:Connect(function(i, gp)
	if not gp and i.KeyCode == Enum.KeyCode.RightShift then UI.setVisible(not UI.visible) end
end))
Core.maid:Add(Threats.listen(function(e)
	notify("Threat detected", string.format("%s — %s", e.source, e.desc), e.sev == 3 and "danger" or "warn", 6)
	refreshAll()
end))
Core.maid:Add(task.spawn(function()
	while alive do
		task.wait(1.5)
		for name in pairs(CoreLock.types) do coreSet(name, false) end
	end
end))

-- restore saved setup
do
	local d = Cfg.read("default")
	if d then pcall(Cfg.apply, d) end
end
Booting = false
refreshAll()

UI.setVisible(true)
genv.GaiaLoaded = true
genv.GaiaUnload = UI.unload
-- Legacy unload alias keeps compatibility with scripts that still look for Surety.
genv.SuretyUnload = UI.unload
notify("Gaia loaded", TOUCH and "Tap the logo to open or close." or "Press RightShift to show or hide.", "ok", 4)
