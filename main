	Crimson = theme(Color3.fromRGB(226, 32, 64), Color3.fromRGB(255, 96, 84)),
	Emerald = theme(Color3.fromRGB(46, 230, 140), Color3.fromRGB(0, 200, 225)),
	Violet = theme(Color3.fromRGB(155, 115, 255), Color3.fromRGB(80, 170, 255)),
	Amber = theme(Color3.fromRGB(255, 178, 36), Color3.fromRGB(255, 108, 62)),
