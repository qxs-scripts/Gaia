local Themed, FontReg, ThemeHooks = {}, {}, {}
local function prune(list)
	local keep = {}
	for _, e in ipairs(list) do if e[1].Parent then keep[#keep + 1] = e end end
	return keep
end
local function T(o, prop, key)
	if #Themed > 2500 then Themed = prune(Themed) end
	Themed[#Themed + 1] = {o, prop, key}
	o[prop] = Theme[key]
	return o
end
local function F(o, bold)
	if #FontReg > 2500 then FontReg = prune(FontReg) end
	FontReg[#FontReg + 1] = {o, bold and true or false}
	o.Font = FontSets[Settings.font][bold and 2 or 1]
	return o
end

---------------------------------------------------------------------
-- Small utilities
---------------------------------------------------------------------
local NewInstance = Instance.new
local function New(class, props, kids)
	local o = NewInstance(class)
	local parent
	if props then
		for k, v in pairs(props) do
			if k == "Parent" then parent = v else o[k] = v end
		end
	end
	if kids then for _, c in ipairs(kids) do c.Parent = o end end
	if parent then o.Parent = parent end
	return o
end

local function deepcopy(t)
	if type(t) ~= "table" then return t end
	local c = {}
	for k, v in pairs(t) do c[k] = deepcopy(v) end
	return c
end

local function escapeRich(s)
	return (tostring(s):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

local function replaceCI(s, needle, repl)
	if needle == "" then return s end
	local ls, ln = s:lower(), needle:lower()
	local out, i = {}, 1
	while true do
		local a, b = ls:find(ln, i, true)
		if not a then out[#out + 1] = s:sub(i); break end
		out[#out + 1] = s:sub(i, a - 1)
		out[#out + 1] = repl
		i = b + 1
	end
	return table.concat(out)
end

local function fmtNum(v) return (v % 1 == 0) and tostring(v) or string.format("%.1f", v) end
local function fmtPct(v) return math.floor(v * 100 + 0.5) .. "%" end

local Maid = {}
Maid.__index = Maid
function Maid.new() return setmetatable({t = {}}, Maid) end
function Maid:Add(x) self.t[#self.t + 1] = x; return x end
function Maid:Clean()
	local t = self.t
	self.t = {}
	for _, x in ipairs(t) do
		local ty = typeof(x)
		if ty == "RBXScriptConnection" then pcall(x.Disconnect, x)
		elseif ty == "Instance" then pcall(x.Destroy, x)
		elseif ty == "function" then pcall(x)
		elseif ty == "thread" then pcall(task.cancel, x) end
	end
end

local Core = {maid = Maid.new()}
local UI = {}
local Ctl = {}
local Features = {}
local internalRoots = {}
local notify, refreshAll, markDirty, setFeature, restart

local function isInternal(inst)
	local a = inst
	while a do
		if internalRoots[a] then return true end
		a = a.Parent
	end
	return false
end

---------------------------------------------------------------------
-- Threat bus
---------------------------------------------------------------------
local SEV_NAME = {"LOW", "MED", "HIGH"}
local SEV_KEY = {"accent", "warn", "danger"}
local Threats = {entries = {}, listeners = {}, counts = {0, 0, 0}, total = 0, last = nil, cool = {}}

function Threats.listen(fn)
	Threats.listeners[#Threats.listeners + 1] = fn
	return function()
		for i, v in ipairs(Threats.listeners) do
			if v == fn then table.remove(Threats.listeners, i) break end
		end
	end
end

local function report(source, desc, sev, key)
	if not alive then return end
	sev = sev or 2
	key = key or (source .. desc)
	local now = os.clock()
	if Threats.cool[key] and now - Threats.cool[key] < 5 then return end
	Threats.cool[key] = now
	local entry = {t = os.time(), source = source, desc = desc, sev = sev}
	local tl = Features.threatlog
	if tl and tl.enabled then
		table.insert(Threats.entries, 1, entry)
		if #Threats.entries > 200 then table.remove(Threats.entries) end
	end
	Threats.total = Threats.total + 1
	Threats.counts[sev] = Threats.counts[sev] + 1
	Threats.last = entry
	for _, cb in ipairs(Threats.listeners) do task.spawn(cb, entry) end
end

---------------------------------------------------------------------
-- Shared locks (so features never fight over the same Roblox UI)
---------------------------------------------------------------------
local CoreLock = {types = {}}
local function coreSet(name, enabled)
	pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType[name], enabled)
end
function CoreLock.acquire(name, owner)
	local e = CoreLock.types[name]
	if not e then
		local ok, cur = pcall(StarterGui.GetCoreGuiEnabled, StarterGui, Enum.CoreGuiType[name])
		e = {owners = {}, n = 0, orig = (ok and cur) ~= false}
		CoreLock.types[name] = e
	end
	if not e.owners[owner] then e.owners[owner] = true; e.n = e.n + 1 end
	coreSet(name, false)
end
function CoreLock.release(name, owner)
	local e = CoreLock.types[name]
	if not e or not e.owners[owner] then return end
	e.owners[owner] = nil
	e.n = e.n - 1
	if e.n <= 0 then
		CoreLock.types[name] = nil
		coreSet(name, e.orig)
	end
end

local GuiLock = {map = {}}
function GuiLock.acquire(gui, owner)
	local e = GuiLock.map[gui]
	if not e then
		e = {owners = {}, n = 0, orig = gui.Enabled}
		e.conn = gui:GetPropertyChangedSignal("Enabled"):Connect(function()
			if e.n > 0 and gui.Enabled then gui.Enabled = false end
		end)
		GuiLock.map[gui] = e
	end
	if not e.owners[owner] then e.owners[owner] = true; e.n = e.n + 1 end
	gui.Enabled = false
end
function GuiLock.release(gui, owner)
	local e = GuiLock.map[gui]
	if not e or not e.owners[owner] then return end
	e.owners[owner] = nil
	e.n = e.n - 1
	if e.n <= 0 then
		e.conn:Disconnect()
		GuiLock.map[gui] = nil
		if gui.Parent then gui.Enabled = e.orig end
	end
end

---------------------------------------------------------------------
-- Hook infrastructure (one __namecall hook, gated per feature)
---------------------------------------------------------------------
local NC = {map = {}, installed = false}
local function ncRegister(methods, id, fn)
	for _, m in ipairs(methods) do
		NC.map[m] = NC.map[m] or {}
		table.insert(NC.map[m], {id = id, fn = fn})
	end
end
local function ncInstall()
	if NC.installed then return true end
	if not Caps.hooks then return false end
	local ok = pcall(function()
		NC.old = Caps.hookmetamethod(game, "__namecall", Caps.newcclosure(function(self, ...)
			local method = Caps.getnamecallmethod()
			local list = NC.map[method]
			if list then
				for i = 1, #list do
					local h = list[i]
					local feat = Features[h.id]
					if feat and feat.enabled then
						local okc, blocked, ret = pcall(h.fn, self, method, ...)
						if okc and blocked then return table.unpack(ret, 1, ret.n or #ret) end
					end
				end
				if Caps.setnamecallmethod then Caps.setnamecallmethod(method) end
			end
			return NC.old(self, ...)
		end))
	end)
	NC.installed = ok
	return ok
end

local IDX = {installed = false, alias = nil}
local function idxInstall()
	if IDX.installed or not Caps.hookmetamethod then return IDX.installed end
	local ok = pcall(function()
		IDX.old = Caps.hookmetamethod(game, "__index", Caps.newcclosure(function(self, key)
			if IDX.alias and (key == "Name" or key == "DisplayName") and self == LocalPlayer
				and not (Caps.checkcaller and Caps.checkcaller()) then
				return IDX.alias
			end
			return IDX.old(self, key)
		end))
	end)
	IDX.installed = ok
	return ok
end

---------------------------------------------------------------------
-- UI primitives
---------------------------------------------------------------------
local function Corner(o, r) return New("UICorner", {CornerRadius = UDim.new(0, r), Parent = o}) end
local function Stroke(o, key, th, tr)
	local s = New("UIStroke", {Thickness = th or 1, Transparency = tr or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = o})
	T(s, "Color", key or "line")
	return s
end
local function Pad(o, l, t, r, b)
	return New("UIPadding", {
		PaddingLeft = UDim.new(0, l), PaddingTop = UDim.new(0, t or l),
		PaddingRight = UDim.new(0, r or l), PaddingBottom = UDim.new(0, b or t or l), Parent = o,
	})
end
local function List(o, pad, dir, ha, va)
	return New("UIListLayout", {
		SortOrder = SORT, Padding = UDim.new(0, pad or 0), FillDirection = dir or Enum.FillDirection.Vertical,
		HorizontalAlignment = ha or Enum.HorizontalAlignment.Left,
		VerticalAlignment = va or Enum.VerticalAlignment.Top, Parent = o,
	})
end
local function Grad(o, rot)
	local g = New("UIGradient", {Rotation = rot or 0, Parent = o})
	local function upd() g.Color = ColorSequence.new(Theme.accent, Theme.accent2) end
	ThemeHooks[#ThemeHooks + 1] = {upd, g}
	upd()
	return g
end
local function Label(parent, text, size, key, bold, props)
	local l = New("TextLabel", {
		BackgroundTransparency = 1, Text = text or "", TextSize = size, TextXAlignment = LEFT,
		TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Y, BorderSizePixel = 0, Parent = parent,
	})
	T(l, "TextColor3", key or "text")
	F(l, bold)
	if props then for k, v in pairs(props) do l[k] = v end end
	return l
end

local Refreshers = {}
local function addRefresh(fn, inst)
	Refreshers[#Refreshers + 1] = {fn, inst}
	pcall(fn)
end

local function Btn(parent, text, kind, fn, props)
	local b = New("TextButton", {
		Text = text, TextSize = 12, AutoButtonColor = false, AutomaticSize = X,
		Size = UDim2.fromOffset(0, TOUCH and 36 or 30), BorderSizePixel = 0, Parent = parent,
	})
	local solid = kind == "primary" or kind == "danger"
	T(b, "BackgroundColor3", kind == "primary" and "accent" or kind == "danger" and "danger" or "raised")
	T(b, "TextColor3", solid and "onAccent" or "text")
	F(b, true); Corner(b, 8); Pad(b, 14, 0)
	if not solid then Stroke(b, "line") end
	b.Activated:Connect(function() if fn then fn(b) end end)
	local function baseColor()
		return kind == "primary" and Theme.accent or kind == "danger" and Theme.danger or Theme.raised
	end
	b.MouseEnter:Connect(function()
		local c = solid and baseColor():Lerp(Color3.new(1, 1, 1), 0.14) or Theme.line
		TweenService:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = c}):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = baseColor()}):Play()
	end)
	if props then for k, v in pairs(props) do b[k] = v end end
	return b
end

local function Switch(parent, get, onClick)
	local b = New("TextButton", {Text = "", AutoButtonColor = false, Size = UDim2.fromOffset(42, 24), BorderSizePixel = 0, Parent = parent})
	Corner(b, 12); Stroke(b, "line")
	local k = New("Frame", {Size = UDim2.fromOffset(18, 18), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0), BorderSizePixel = 0, Parent = b})
	Corner(k, 9)
	local function render()
		local on = get()
		TweenService:Create(b, TweenInfo.new(0.15), {BackgroundColor3 = on and Theme.accent or Theme.raised}):Play()
		TweenService:Create(k, TweenInfo.new(0.15), {
			Position = on and UDim2.new(0, 21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
			BackgroundColor3 = on and Theme.onAccent or Theme.sub,
		}):Play()
	end
	b.Activated:Connect(function() onClick(); render() end)
	addRefresh(render, b)
	return b
end

local function Card(parent, title)
	local c = New("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Y, BorderSizePixel = 0, Parent = parent})
	T(c, "BackgroundColor3", "surface"); Corner(c, 10); Stroke(c, "line"); Pad(c, 14)
	List(c, 8)
	if title then Label(c, title, 11, "sub", true) end
	return c
end

local function Divider(parent)
	local d = New("Frame", {Size = UDim2.new(1, 0, 0, 1), BorderSizePixel = 0, Parent = parent})
	T(d, "BackgroundColor3", "line")
	return d
end

local function Chip(parent, text, state)
	local c = New("Frame", {AutomaticSize = Enum.AutomaticSize.XY, Size = UDim2.fromOffset(0, 22), BorderSizePixel = 0, Parent = parent})
	T(c, "BackgroundColor3", "raised"); Corner(c, 11); Pad(c, 20, 0, 10, 0)
	local dot = New("Frame", {Size = UDim2.fromOffset(6, 6), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, -12, 0.5, 0), BorderSizePixel = 0, Parent = c})
	Corner(dot, 3)
	T(dot, "BackgroundColor3", state == true and "ok" or state == false and "danger" or "accent")
	local l = New("TextLabel", {BackgroundTransparency = 1, Text = text, TextSize = 11, AutomaticSize = Enum.AutomaticSize.XY, Size = UDim2.fromOffset(0, 22), Parent = c})
	T(l, "TextColor3", "text"); F(l, false)
	return c
end

---------------------------------------------------------------------
-- Logo: sharp, rounded geometric "G" lettermark (transparent background)
---------------------------------------------------------------------
local Logo = {}

-- A near-complete circular stroke, opened on the right and finished with
-- the inward bar that makes the mark read as a G.
local function gPath()
	local pts = {}
	for i = 0, 32 do
		local a = math.rad(-45 - 270 * i / 32)
		pts[#pts + 1] = Vector2.new(50 + 34 * math.cos(a), 50 + 34 * math.sin(a))
	end
	pts[#pts + 1] = Vector2.new(74, 56)
	pts[#pts + 1] = Vector2.new(50, 56)
	return pts
end
local G_PATH = gPath()

function Logo.create(parent, px)
	local root = New("Frame", {Name = "Logo", Size = UDim2.fromOffset(px, px), BackgroundTransparency = 1, Active = false, Parent = parent})
	local k = px / 100
	local segs = {}
	for i = 1, #G_PATH - 1 do
		local a, b = G_PATH[i], G_PATH[i + 1]
		local t = (i - 0.5) / (#G_PATH - 1)
		local th = 1.5 + 14 * math.sin(math.pi * t) ^ 0.55
		local d = b - a
		local mid = (a + b) / 2
		local seg = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(mid.X * k, mid.Y * k),
			Size = UDim2.fromOffset(math.max(1, (d.Magnitude + th * 0.7) * k), math.max(1, th * k)),
			Rotation = math.deg(math.atan2(d.Y, d.X)), BorderSizePixel = 0, ZIndex = 2, Parent = root,
		})
		New("UICorner", {CornerRadius = UDim.new(0.5, 0), Parent = seg})
		segs[#segs + 1] = {seg, t}
	end

	-- Rotate the colour sweep around the individual strokes without adding
	-- a tile, border, or other background behind the mark.
	local rotation = 0
	local function paint()
		for _, e in ipairs(segs) do
			local colourT = (e[2] + rotation) % 1
			e[1].BackgroundColor3 = Theme.accent:Lerp(Theme.accent2, colourT)
		end
	end
	local animation = setmetatable({}, {
		__newindex = function(_, key, value)
			if key == "Rotation" and type(value) == "number" then
				rotation = (value % 360) / 360
				paint()
			end
		end,
	})
	ThemeHooks[#ThemeHooks + 1] = {paint, root}
	paint()
	return root, animation
end

---------------------------------------------------------------------
-- Icons: generated from frames (no asset ids needed)
---------------------------------------------------------------------
local Icon = {}
function Icon.create(parent, name, px)
	local root = New("Frame", {Name = "Icon_" .. name, Size = UDim2.fromOffset(px, px), BackgroundTransparency = 1, Active = false, Parent = parent})
	local parts = {}
	local k = px / 24
	local function bar(cx, cy, len, th, rot)
		local f = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(cx * k, cy * k),
			Size = UDim2.fromOffset(math.max(1, len * k), math.max(1, th * k)), Rotation = rot or 0, BorderSizePixel = 0, Parent = root,
		})
		New("UICorner", {CornerRadius = UDim.new(0.5, 0), Parent = f})
		parts[#parts + 1] = {f, "fill"}
	end
	local function dot(cx, cy, d)
		local f = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(cx * k, cy * k),
			Size = UDim2.fromOffset(d * k, d * k), BorderSizePixel = 0, Parent = root,
		})
		New("UICorner", {CornerRadius = UDim.new(0.5, 0), Parent = f})
		parts[#parts + 1] = {f, "fill"}
	end
	local function box(x, y, w, h, th, r, filled)
		local f = New("Frame", {Position = UDim2.fromOffset(x * k, y * k), Size = UDim2.fromOffset(w * k, h * k), BorderSizePixel = 0, Parent = root})
		New("UICorner", {CornerRadius = UDim.new(0, r * k), Parent = f})
		if filled then
			parts[#parts + 1] = {f, "fill"}
		else
			f.BackgroundTransparency = 1
			local s = New("UIStroke", {Thickness = math.max(1, th * k), ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = f})
			parts[#parts + 1] = {s, "stroke"}
		end
	end

	if name == "home" then
		bar(7.75, 7.5, 11, 2, -39.5); bar(16.25, 7.5, 11, 2, 39.5)
		bar(7.5, 13.5, 12, 2, 90); bar(16.5, 13.5, 12, 2, 90); bar(12, 19.5, 11, 2, 0)
		bar(12, 16.3, 5, 2.2, 90)
	elseif name == "grid" then
		box(4, 4, 7, 7, 1.8, 2, false); box(13, 4, 7, 7, 1.8, 2, false)
		box(4, 13, 7, 7, 1.8, 2, false); box(13, 13, 7, 7, 1.8, 2, true)
	elseif name == "sliders" then
		bar(12, 6.5, 17, 2, 0); bar(12, 12, 17, 2, 0); bar(12, 17.5, 17, 2, 0)
		dot(15.5, 6.5, 5.5); dot(8, 12, 5.5); dot(13, 17.5, 5.5)
	elseif name == "alert" then
		bar(7.75, 11.5, 17.3, 2, -60.5); bar(16.25, 11.5, 17.3, 2, 60.5); bar(12, 19, 17, 2, 0)
		bar(12, 12.4, 5.5, 2, 90); dot(12, 16.2, 2.2)
	elseif name == "minimize" then
		bar(12, 12, 12, 2, 0)
	elseif name == "close" then
		bar(12, 12, 15, 2, 45); bar(12, 12, 15, 2, -45)
	end

	local function set(c)
		for _, p in ipairs(parts) do
			if p[2] == "fill" then p[1].BackgroundColor3 = c else p[1].Color = c end
		end
	end
	set(Theme.text)
	return {root = root, set = set}
end

---------------------------------------------------------------------
-- Controls (bound to tbl[key])
---------------------------------------------------------------------
Ctl.scroller = nil
local ROWH = TOUCH and 38 or 32

function Ctl.Note(parent, text)
	return Label(parent, text, 11, "sub")
end

function Ctl.Header(parent, text)
	return Label(parent, text, 11, "accent", true)
end

function Ctl.Toggle(parent, label, tbl, key, onChange)
	local row = New("Frame", {Size = UDim2.new(1, 0, 0, ROWH), AutomaticSize = Y, BackgroundTransparency = 1, Parent = parent})
	List(row, 8, HORIZ, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	Label(row, label, 12, "text", false, {Size = UDim2.new(1, -56, 0, 0), TextYAlignment = Enum.TextYAlignment.Center})
	Switch(row, function() return tbl[key] == true end, function()
		tbl[key] = not (tbl[key] == true)
		markDirty()
		if onChange then onChange(tbl[key]) end
	end)
	return row
end

function Ctl.Segment(parent, label, tbl, key, values, onChange, swatch)
	local row = New("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Y, BackgroundTransparency = 1, Parent = parent})
	List(row, 6)
	Label(row, label, 12, "text")
	local wrap = New("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Y, BackgroundTransparency = 1, Parent = row})
	local lay = List(wrap, 6, HORIZ); lay.Wraps = true
	for _, v in ipairs(values) do
		local b = New("TextButton", {
			Text = v, TextSize = 12, AutoButtonColor = false, AutomaticSize = X,
			Size = UDim2.fromOffset(0, TOUCH and 34 or 28), BorderSizePixel = 0, Parent = wrap,
		})
		F(b, false); Corner(b, 6); Pad(b, swatch and 26 or 12, 0, 12, 0)
		local stroke = Stroke(b, "line")
		if swatch then
			local d = New("Frame", {Size = UDim2.fromOffset(10, 10), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, -17, 0.5, 0), BackgroundColor3 = swatch(v), BorderSizePixel = 0, Parent = b})
			Corner(d, 5)
		end
		addRefresh(function()
			local on = tbl[key] == v
			b.BackgroundColor3 = on and Theme.accent or Theme.raised
			b.TextColor3 = on and Theme.onAccent or Theme.text
			stroke.Color = on and Theme.accent or Theme.line
		end, b)
		b.Activated:Connect(function()
			tbl[key] = v
			markDirty()
			if onChange then onChange(v) end
			refreshAll()
		end)
	end
	return row
end

function Ctl.Slider(parent, label, tbl, key, min, max, step, fmt, onChange)
	fmt = fmt or fmtNum
	local scroller = Ctl.scroller
	local row = New("Frame", {Size = UDim2.new(1, 0, 0, 46), BackgroundTransparency = 1, Parent = parent})
	Label(row, label, 12, "text", false, {Size = UDim2.new(1, -70, 0, 16), AutomaticSize = Enum.AutomaticSize.None})
	local val = Label(row, "", 12, "accent", true, {Size = UDim2.new(0, 70, 0, 16), Position = UDim2.new(1, -70, 0, 0), AutomaticSize = Enum.AutomaticSize.None, TextXAlignment = RIGHT})
	local hit = New("TextButton", {Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28), Position = UDim2.new(0, 0, 0, 18), Parent = row})
	local line = New("Frame", {Size = UDim2.new(1, 0, 0, 6), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), BorderSizePixel = 0, Parent = hit})
	T(line, "BackgroundColor3", "raised"); Corner(line, 3)
	local fill = New("Frame", {Size = UDim2.fromScale(0, 1), BorderSizePixel = 0, Parent = line})
	T(fill, "BackgroundColor3", "accent"); Corner(fill, 3)
	local knob = New("Frame", {Size = UDim2.fromOffset(16, 16), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), BorderSizePixel = 0, Parent = line})
	T(knob, "BackgroundColor3", "text"); Corner(knob, 8)
	local function render()
		local v = tonumber(tbl[key]) or min
		local r = math.clamp((v - min) / (max - min), 0, 1)
		fill.Size = UDim2.fromScale(r, 1)
		knob.Position = UDim2.fromScale(r, 0.5)
		val.Text = fmt(v)
	end
	local function setX(px)
		local w = hit.AbsoluteSize.X
		if w <= 0 then return end
		local r = math.clamp((px - hit.AbsolutePosition.X) / w, 0, 1)
		local v = min + (max - min) * r
		v = math.clamp(math.floor(v / step + 0.5) * step, min, max)
		v = tonumber(string.format("%.3f", v))
		if tbl[key] ~= v then
			tbl[key] = v
			render()
			if onChange then onChange(v) end
		end
	end
	local dragging = false
	hit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			if scroller then scroller.ScrollingEnabled = false end
			setX(i.Position.X)
			local c
			c = i.Changed:Connect(function()
				if i.UserInputState == Enum.UserInputState.End then
					dragging = false
					if scroller then scroller.ScrollingEnabled = true end
					c:Disconnect()
					markDirty()
				end
			end)
		end
	end)
	Core.maid:Add(UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			setX(i.Position.X)
		end
	end))
	addRefresh(render, row)
	return row
end

function Ctl.Text(parent, label, tbl, key, placeholder, onChange)
	local row = New("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Y, BackgroundTransparency = 1, Parent = parent})
	List(row, 6)
	if label then Label(row, label, 12, "text") end
	local box = New("TextBox", {
		Text = tostring(tbl[key] or ""), PlaceholderText = placeholder or "", TextSize = 12, ClearTextOnFocus = false,
		TextXAlignment = LEFT, Size = UDim2.new(1, 0, 0, TOUCH and 38 or 32), BorderSizePixel = 0, Parent = row,
	})
	T(box, "BackgroundColor3", "raised"); T(box, "TextColor3", "text"); T(box, "PlaceholderColor3", "sub")
	F(box, false); Corner(box, 6); Stroke(box, "line"); Pad(box, 10, 0)
	box.FocusLost:Connect(function()
		tbl[key] = box.Text
		markDirty()
		if onChange then onChange(box.Text) end
	end)
	addRefresh(function() if not box:IsFocused() then box.Text = tostring(tbl[key] or "") end end, box)
	return row, box
end

function Ctl.Buttons(parent, list)
	local row = New("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Y, BackgroundTransparency = 1, Parent = parent})
	local lay = List(row, 8, HORIZ); lay.Wraps = true
	for _, b in ipairs(list) do Btn(row, b[1], b[3], b[2]) end
	return row
end

---------------------------------------------------------------------
-- Feature framework
---------------------------------------------------------------------
local ModuleList = {
	{id = "privacy", name = "Privacy", desc = "Hide who you are and what is on your screen."},
	{id = "exploit", name = "Exploit Protection", desc = "Watch for hostile behaviour and protect your character."},
	{id = "extras", name = "Extras", desc = "Alarms, logging, bait, scanning and emergency tools."},
}
local ModuleFeatures = {privacy = {}, exploit = {}, extras = {}}

local function define(def)
	def.enabled = false
	def.maid = Maid.new()
	def.opts = def.opts or {}
	def.defaults = deepcopy(def.opts)
	Features[def.id] = def
	table.insert(ModuleFeatures[def.module], def)
	return def
end

function setFeature(id, on, silent)
	local f = Features[id]
	if not f or f.type == "action" or f.enabled == on then return end
	if on then
		if f.supported then
			local ok, why = f.supported()
			if not ok then
				if not silent then notify(f.name, why or "Not supported on this executor.", "warn") end
				return
			end
		end
		f.enabled = true
		local ok, err = pcall(f.start, f, f.maid)
		if not ok then
			f.enabled = false
			f.maid:Clean()
			notify(f.name, "Failed to start: " .. tostring(err), "danger")
			refreshAll()
			return
		end
	else
		f.enabled = false
		f.maid:Clean()
		f.status = nil
	end
	markDirty()
	refreshAll()
	if not silent then notify(f.name, on and "Enabled" or "Disabled", on and "ok" or "info", 2.5) end
end

function restart(f)
	if f.enabled then
		f.maid:Clean()
		local ok, err = pcall(f.start, f, f.maid)
		if not ok then f.enabled = false; notify(f.name, "Restart failed: " .. tostring(err), "danger") end
		refreshAll()
	end
end

local function counts()
	local on, total = 0, 0
	local per = {}
	for _, m in ipairs(ModuleList) do
		local a, t = 0, 0
		for _, f in ipairs(ModuleFeatures[m.id]) do
			if f.type ~= "action" then
				t = t + 1
				if f.enabled then a = a + 1 end
			end
		end
		per[m.id] = {a, t}
		on = on + a; total = total + t
	end
	return on, total, per
end

local Emergency = {active = false, snap = {}}
local function emergencyShutdown()
	if Emergency.active then return end
	Emergency.active = true
	Emergency.snap = {}
	local keepLog = Features.shutdown and Features.shutdown.opts.keepLog
	for id, f in pairs(Features) do
		if f.type ~= "action" and f.enabled and not (id == "threatlog" and keepLog) then
			Emergency.snap[#Emergency.snap + 1] = id
			setFeature(id, false, true)
		end
	end
	notify("Emergency Shutdown", "All optional Gaia features were switched off.", "danger", 6)
	refreshAll()
end
local function emergencyRestore()
	if not Emergency.active then return end
	Emergency.active = false
	for _, id in ipairs(Emergency.snap) do setFeature(id, true, true) end
	Emergency.snap = {}
	notify("Restored", "Previously active features are back on.", "ok")
	refreshAll()
end

local RECOMMENDED = {"antiss", "identity", "logger", "guidetect", "remotes", "charprot", "instances", "alarm", "threatlog", "scanner"}

---------------------------------------------------------------------
-- PRIVACY MODULE
---------------------------------------------------------------------
-- Anti-Screenshot ----------------------------------------------------
define{
	id = "antiss", module = "privacy", name = "Anti-Screenshot",
	desc = "Hides your player list, chat, name tags and Gaia itself when a screenshot or recording is detected.",
	opts = {mode = TOUCH and "Always" or "On capture", hold = 3},
	build = function(f, p)
		Ctl.Segment(p, "Mode", f.opts, "mode", {"On capture", "Always"}, function() restart(f) end)
		Ctl.Slider(p, "Hold time after a capture (s)", f.opts, "hold", 1, 8, 0.5, fmtNum)
		Ctl.Note(p, "Phone/OS-level screenshots can't be detected from inside Roblox. On mobile use \"Always\".")
		Ctl.Buttons(p, {{"Test shield", function() if f.enabled and f.trigger then f.trigger() end end}})
	end,
	start = function(f, maid)
		local nt, shielded = {}, false
		local function tags(hide)
			for _, pl in ipairs(Players:GetPlayers()) do
				local h = pl.Character and pl.Character:FindFirstChildOfClass("Humanoid")
				if h then
					if hide then
						if nt[h] == nil then nt[h] = h.DisplayDistanceType end
						h.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
					elseif nt[h] ~= nil then
						h.DisplayDistanceType = nt[h]; nt[h] = nil
					end
				end
			end
		end
		local function shield(on, hideSelf)
			shielded = on
			if on then
				CoreLock.acquire("PlayerList", "antiss"); CoreLock.acquire("Chat", "antiss")
				tags(true)
				if hideSelf then UI.setCaptureHidden(true) end
			else
				CoreLock.release("PlayerList", "antiss"); CoreLock.release("Chat", "antiss")
				tags(false)
				UI.setCaptureHidden(false)
			end
		end
		maid:Add(function() shield(false) end)
		local token = 0
		local function trigger()
			shield(true, true)
			token = token + 1
			local mine = token
			report("Anti-Screenshot", "Capture detected — interface hidden.", 1, "capture")
			task.delay(f.opts.hold, function()
				if mine == token and f.enabled then
					if f.opts.mode == "Always" then UI.setCaptureHidden(false) else shield(false) end
				end
			end)
		end
		f.trigger = trigger
		if f.opts.mode == "Always" then shield(true, false) end
		maid:Add(UIS.InputBegan:Connect(function(i)
			if i.KeyCode == Enum.KeyCode.Print or i.KeyCode == Enum.KeyCode.F12 then trigger() end
		end))
		pcall(function()
			local cs = game:GetService("CaptureService")
			maid:Add(cs.CaptureBegan:Connect(trigger))
		end)
		maid:Add(task.spawn(function()
			while true do
				task.wait(2)
				if shielded then tags(true) end
			end
		end))
	end,
}

-- Disable Chat -------------------------------------------------------
ncRegister({"SendAsync", "FireServer"}, "nochat", function(self, method)
	if typeof(self) ~= "Instance" then return end
	if method == "SendAsync" then
		if self.ClassName == "TextChannel" then return true, {n = 1} end
	elseif self.Name == "SayMessageRequest" then
		return true, {n = 0}
	end
end)
define{
	id = "nochat", module = "privacy", name = "Disable Chat",
	desc = "Removes the chat window, chat bubbles and outgoing chat for this client.",
	start = function(f, maid)
		CoreLock.acquire("Chat", "nochat")
		maid:Add(function() CoreLock.release("Chat", "nochat") end)
		local saved = {}
		for _, n in ipairs({"ChatWindowConfiguration", "ChatInputBarConfiguration", "BubbleChatConfiguration"}) do
			local c = TextChatService and TextChatService:FindFirstChild(n)
			if c then
				saved[c] = c.Enabled
				c.Enabled = false
				maid:Add(c:GetPropertyChangedSignal("Enabled"):Connect(function()
					if c.Enabled then c.Enabled = false end
				end))
			end
		end
		maid:Add(function() for c, v in pairs(saved) do if c.Parent then c.Enabled = v end end end)
		-- legacy bubble chat
		local held = {}
		local function bubble(inst)
			if (inst.ClassName == "ScreenGui" or inst.ClassName == "BillboardGui") and inst.Name == "BubbleChat" and not held[inst] then
				held[inst] = inst.Enabled
				inst.Enabled = false
				maid:Add(inst:GetPropertyChangedSignal("Enabled"):Connect(function()
					if inst.Enabled then inst.Enabled = false end
				end))
			end
		end
		for _, root in ipairs({PlayerGui, CoreGui}) do
			pcall(function()
				for _, d in ipairs(root:GetChildren()) do bubble(d) end
				maid:Add(root.ChildAdded:Connect(bubble))
			end)
		end
		maid:Add(function() for inst, v in pairs(held) do if inst.Parent then inst.Enabled = v end end end)
		if not ncInstall() then f.status = "UI hidden (outgoing-message block needs hooks)" else f.status = nil end
	end,
}

-- GUI Protector ------------------------------------------------------
local CORE_GUIS = {"PlayerList", "Chat", "Backpack", "Health", "EmotesMenu"}
define{
	id = "guiprot", module = "privacy", name = "GUI Protector",
	desc = "Hide the interface elements you choose (Roblox menus or game GUIs) on this client.",
	opts = {hidden = {}},
	build = function(f, p)
		Ctl.Note(p, "Pick what to hide. Changes apply instantly while the feature is on.")
		local list = New("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Y, BackgroundTransparency = 1, Parent = p})
		List(list, 2)
		local function rebuild()
			for _, c in ipairs(list:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
			Ctl.Header(list, "ROBLOX INTERFACE")
			for _, n in ipairs(CORE_GUIS) do
				Ctl.Toggle(list, n, f.opts.hidden, "core:" .. n, function() restart(f) end)
			end
			Ctl.Header(list, "GAME GUIS")
			local seen = {}
			for _, g in ipairs(PlayerGui:GetChildren()) do
				if g:IsA("ScreenGui") and not isInternal(g) and not seen[g.Name] then
					seen[g.Name] = true
					Ctl.Toggle(list, g.Name, f.opts.hidden, g.Name, function() restart(f) end)
				end
			end
		end
		rebuild()
		Ctl.Buttons(p, {{"Refresh list", rebuild}})
	end,
	start = function(f, maid)
		local function apply()
			for key, on in pairs(f.opts.hidden) do
				if on == true then
					if key:sub(1, 5) == "core:" then
						CoreLock.acquire(key:sub(6), "guiprot")
					else
						for _, g in ipairs(PlayerGui:GetChildren()) do
							if g:IsA("ScreenGui") and g.Name == key and not isInternal(g) then GuiLock.acquire(g, "guiprot") end
						end
					end
				end
			end
		end
		maid:Add(function()
			for key in pairs(f.opts.hidden) do
				if key:sub(1, 5) == "core:" then CoreLock.release(key:sub(6), "guiprot") end
			end
			for _, g in ipairs(PlayerGui:GetChildren()) do
				if g:IsA("ScreenGui") then GuiLock.release(g, "guiprot") end
			end
		end)
		apply()
		maid:Add(PlayerGui.ChildAdded:Connect(function(g)
			if g:IsA("ScreenGui") and f.opts.hidden[g.Name] == true and not isInternal(g) then
				task.defer(function() if f.enabled then GuiLock.acquire(g, "guiprot") end end)
			end
		end))
	end,
}

-- Identity Protector -------------------------------------------------
define{
	id = "identity", module = "privacy", name = "Identity Protector",
	desc = "Replaces your username and display name with an alias in every interface you can see.",
	opts = {alias = "Anonymous", deep = false},
	build = function(f, p)
		Ctl.Text(p, "Alias", f.opts, "alias", "Anonymous", function() restart(f) end)
		Ctl.Toggle(p, "Deep spoof (game scripts)", f.opts, "deep", function() restart(f) end)
		Ctl.Note(p, "Deep spoof also feeds the alias to game scripts that read your name. It hooks property reads and may cost FPS. Visual only — the server still knows who you are.")
	end,
	start = function(f, maid)
		local realName, realDisplay = LocalPlayer.Name, LocalPlayer.DisplayName
		local alias = (f.opts.alias and f.opts.alias ~= "") and f.opts.alias or "Anonymous"
		local needles = {}
		for _, n in ipairs({realName, realDisplay}) do
			if n ~= "" and n:lower() ~= alias:lower() then needles[#needles + 1] = n end
		end
		local running = true
		maid:Add(function() running = false end)
		local originals, lastSet = {}, {}
		local function mask(text)
			local out = text
			for _, n in ipairs(needles) do out = replaceCI(out, n, alias) end
			return out
		end
		local function process(inst)
			local cn = inst.ClassName
			if cn ~= "TextLabel" and cn ~= "TextButton" and cn ~= "TextBox" then return end
			if cn == "TextBox" and inst:IsFocused() then return end
			local txt = inst.Text
			if lastSet[inst] == txt then return end
			local masked = mask(txt)
			if masked ~= txt then
				originals[inst] = txt
				lastSet[inst] = masked
				inst.Text = masked
			end
		end
		local function watch(inst)
			local cn = inst.ClassName
			if cn ~= "TextLabel" and cn ~= "TextButton" and cn ~= "TextBox" then return end
			if isInternal(inst) then return end
			process(inst)
			maid:Add(inst:GetPropertyChangedSignal("Text"):Connect(function() process(inst) end))
		end
		maid:Add(function()
			for inst, orig in pairs(originals) do
				if inst.Parent and inst.Text == lastSet[inst] then inst.Text = orig end
			end
		end)
		for _, root in ipairs({CoreGui, PlayerGui}) do
			pcall(function() maid:Add(root.DescendantAdded:Connect(watch)) end)
		end
		task.spawn(function()
			local n = 0
			for _, root in ipairs({CoreGui, PlayerGui}) do
				local ok, desc = pcall(root.GetDescendants, root)
				if ok then
					for _, d in ipairs(desc) do
						if not running then return end
						watch(d)
						n = n + 1
						if n % 250 == 0 then task.wait() end
					end
				end
			end
		end)
		-- overhead name tag (own humanoid)
		local hOrig = {}
		local function humanoid(char)
			local h = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
			if h and running then
				hOrig[h] = hOrig[h] or h.DisplayName
				h.DisplayName = alias
			end
		end
		if LocalPlayer.Character then task.spawn(humanoid, LocalPlayer.Character) end
		maid:Add(LocalPlayer.CharacterAdded:Connect(function(c) task.spawn(humanoid, c) end))
		maid:Add(function() for h, n in pairs(hOrig) do if h.Parent then h.DisplayName = n end end end)
		if f.opts.deep then
			if idxInstall() then
				IDX.alias = alias
				maid:Add(function() IDX.alias = nil end)
			else
				notify("Identity Protector", "Deep spoof needs hookmetamethod — visual masking only.", "warn")
			end
		end
	end,
}

-- Logger Protector ---------------------------------------------------
local LOG_HOSTS = {
	"/api/webhooks/", "hooks.slack.com", "api.telegram.org/bot", "webhook.site", "pipedream.net", "requestbin",
	"requestcatcher", "ngrok", "grabify", "iplogger", "ipify.org", "ip-api.com", "ipinfo.io", "ipapi.co", "ipwho.is",
	"ifconfig.me", "icanhazip", "checkip.", "myexternalip", "whatismyip", "ident.me", "wtfismyip", "ipecho", "geoplugin",
	"canarytokens", "interact.sh", "oast.", "burpcollaborator", "blasze", "yip.su", "2no.co", "leancoding.co", "stopify.co",
	"freegiftcards.co", "joinmy.site", "curiouscat.club", "catsnthings", "lovebird.guru", "iplis.ru", "lewisakura", "hooks.hyra",
}
local SRC_BASE = {"/api/webhooks/", "iplogger", "grabify", "api.ipify", "ip-api.com", "ipinfo.io", "ifconfig.me", "icanhazip", "checkip.amazonaws", "webhook.site"}
local SRC_STRICT = {"gethwid", "get_hwid", "getclientid", "getclipboard"}
local TRUSTED = {"roblox.com", "rbxcdn.com", "robloxlabs.com"}

local function hostOf(url)
	local h = url:lower():match("^%a[%w+.%-]*://([^/%?#]+)") or ""
	h = h:gsub(":%d+$", "")
	return h
end
local function hostMatches(host, d)
	return host == d or (#host > #d and host:sub(-(#d + 1)) == "." .. d)
end
local loggerInstalled = false
local function installLoggerHooks()
	if loggerInstalled then return end
	loggerInstalled = true
	local f = Features.logger
	local fakeHwid = HttpService:GenerateGUID(false):upper()
	local function hit(what, detail)
		report("Logger Protector", string.format("Stopped %s: %s", what, tostring(detail)), 3, "logger:" .. what .. tostring(detail))
	end
	local function allowList()
		local out = {}
		for h in tostring(f.opts.allow or ""):gmatch("[^,%s]+") do out[#out + 1] = h:lower() end
		return out
	end
	local function identityStrings()
		local out = {}
		for _, s in ipairs({LocalPlayer.Name, LocalPlayer.DisplayName, tostring(LocalPlayer.UserId)}) do
			if #s >= 3 then out[#out + 1] = s:lower() end
		end
		return out
	end
	local function inspectUrl(url, opts)
		if type(url) ~= "string" or url == "" then return nil end
		local host = hostOf(url)
		if host == "" then return nil end
		for _, a in ipairs(allowList()) do if hostMatches(host, a) then return nil end end
		for _, d in ipairs(TRUSTED) do if hostMatches(host, d) then return nil end end
		local l = url:lower()
		for _, p in ipairs(LOG_HOSTS) do if l:find(p, 1, true) then return host end end
		if f.opts.strict and opts then
			local body = tostring(opts.Body or ""):lower()
			if body ~= "" then
				for _, s in ipairs(identityStrings()) do if body:find(s, 1, true) then return host end end
			end
		end
		return nil
	end
	local blocked = {Success = false, StatusCode = 403, StatusMessage = "Blocked by Gaia", Body = "", Headers = {}}

	if Caps.hookfunction then
		for _, fn in ipairs(RequestFns) do
			pcall(function()
				local old
				old = Caps.hookfunction(fn, Caps.newcclosure(function(opts, ...)
					if f.enabled and type(opts) == "table" then
						local why = inspectUrl(tostring(opts.Url or opts.URL or opts.url or ""), opts)
						if why then hit("request", why); return blocked end
					end
					return old(opts, ...)
				end))
			end)
		end
		for _, name in ipairs({"gethwid", "get_hwid", "GetHWID"}) do
			local fn = ex(name)
			if typeof(fn) == "function" then
				pcall(function()
					local old
					old = Caps.hookfunction(fn, Caps.newcclosure(function(...)
						if f.enabled and f.opts.blockHwid then hit("HWID read", name); return fakeHwid end
						return old(...)
					end))
				end)
			end
		end
		for _, name in ipairs({"getclipboard", "fromclipboard"}) do
			local fn = ex(name)
			if typeof(fn) == "function" then
				pcall(function()
					local old
					old = Caps.hookfunction(fn, Caps.newcclosure(function(...)
						if f.enabled and f.opts.blockClipboard then hit("clipboard read", name); return "" end
						return old(...)
					end))
				end)
			end
		end
		local ls = ex("loadstring")
		if typeof(ls) == "function" then
			pcall(function()
				local old
				old = Caps.hookfunction(ls, Caps.newcclosure(function(src, ...)
					if f.enabled and f.opts.scanSource and type(src) == "string" and #src < 3000000 then
						local l = src:lower()
						local found
						for _, p in ipairs(SRC_BASE) do if l:find(p, 1, true) then found = p break end end
						if not found and f.opts.strict then
							for _, p in ipairs(SRC_STRICT) do if l:find(p, 1, true) then found = p break end end
						end
						if found then
							hit("script", "contains \"" .. found .. "\"")
							return function() end
						end
					end
					return old(src, ...)
				end))
			end)
		end
	end

	ncRegister({"HttpGet", "HttpGetAsync", "HttpPost", "HttpPostAsync", "GetAsync", "PostAsync", "RequestAsync", "GetClientId"}, "logger", function(self, method, ...)
		if method == "GetClientId" then
			if f.opts.blockHwid and Caps.checkcaller and Caps.checkcaller() then
				hit("client-id read", "RbxAnalyticsService")
				return true, {n = 1, fakeHwid}
			end
			return
		end
		local a = ...
		local url, opts = a, nil
		if type(a) == "table" then url = a.Url or a.URL; opts = a end
		local why = inspectUrl(url, opts)
		if why then
			hit("web request", why)
			if method == "RequestAsync" then return true, {n = 1, blocked} end
			return true, {n = 1, ""}
		end
	end)
end

define{
	id = "logger", module = "privacy", name = "Logger Protector",
	desc = "Stops executor scripts that try to leak your identity — webhooks, IP/HWID lookups, clipboard reads — and notifies you.",
	opts = {strict = false, blockHwid = true, blockClipboard = true, scanSource = true, allow = ""},
	supported = function()
		if Caps.hookfunction or Caps.hooks then return true end
		return false, "Needs hookfunction or hookmetamethod."
	end,
	build = function(f, p)
		Ctl.Toggle(p, "Scan loadstring sources", f.opts, "scanSource")
		Ctl.Toggle(p, "Block HWID / client-id reads", f.opts, "blockHwid")
		Ctl.Toggle(p, "Block clipboard reads", f.opts, "blockClipboard")
		Ctl.Toggle(p, "Strict (also block requests carrying your name/ID)", f.opts, "strict")
		Ctl.Text(p, "Allowed hosts (comma separated)", f.opts, "allow", "example.com, my-api.dev")
		Ctl.Note(p, "Gaia can only intercept what runs after it loads — scripts executed before Gaia are out of reach.")
	end,
	start = function(f)
		installLoggerHooks()
		ncInstall()
		if Caps.hookfunction then f.status = nil else f.status = "Partial: request/HWID hooks need hookfunction" end
	end,
}

