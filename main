-- Executor capabilities
---------------------------------------------------------------------
local function ex(name)
	local v = genv[name]
	if v == nil then
		local ok, r = pcall(function() return getfenv(0)[name] end)
		if ok then v = r end
	end
	return v
end

local Caps = {
	hookfunction = ex("hookfunction") or ex("replaceclosure"),
	hookmetamethod = ex("hookmetamethod"),
	getnamecallmethod = ex("getnamecallmethod"),
	setnamecallmethod = ex("setnamecallmethod"),
	checkcaller = ex("checkcaller"),
	newcclosure = ex("newcclosure") or function(f) return f end,
	setclipboard = ex("setclipboard") or ex("toclipboard"),
	writefile = ex("writefile"), readfile = ex("readfile"), isfile = ex("isfile"),
	isfolder = ex("isfolder"), makefolder = ex("makefolder"), listfiles = ex("listfiles"),
	delfile = ex("delfile"),
}
Caps.fs = (Caps.writefile and Caps.readfile and Caps.isfile and Caps.isfolder and Caps.makefolder and Caps.listfiles) and true or false
Caps.hooks = (Caps.hookmetamethod and Caps.getnamecallmethod) and true or false

local function findRequestFns()
	local out, seen = {}, {}
	local function add(f)
		if typeof(f) == "function" and not seen[f] then seen[f] = true; out[#out + 1] = f end
	end
	add(ex("request")); add(ex("http_request"))
	local syn, http, fl = ex("syn"), ex("http"), ex("fluxus")
	if type(syn) == "table" then add(syn.request) end
	if type(http) == "table" then add(http.request) end
	if type(fl) == "table" then add(fl.request) end
	return out
end
local RequestFns = findRequestFns()

local ExecName, ExecVersion = "Unknown executor", nil
do
	local f = ex("identifyexecutor") or ex("getexecutorname")
	if typeof(f) == "function" then
		local ok, a, b = pcall(f)
		if ok and a then ExecName = tostring(a); ExecVersion = b and tostring(b) or nil end
	end
end

local function pickContainer()
	local gh = ex("gethui")
	if typeof(gh) == "function" then
		local ok, r = pcall(gh)
		if ok and typeof(r) == "Instance" then return r end
	end
	local ok = pcall(function()
		local t = Instance.new("Folder"); t.Parent = CoreGui; t:Destroy()
	end)
	if ok then return CoreGui end
	return PlayerGui
end
local Container = pickContainer()

local function protect(gui)
	pcall(function()
		local p, syn = ex("protect_gui"), ex("syn")
		if typeof(p) == "function" then p(gui)
		elseif type(syn) == "table" and syn.protect_gui then syn.protect_gui(gui) end
	end)
end

