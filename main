-- RemoteEvent Monitor ------------------------------------------------
local SUS_REMOTE = {"admin", "ban", "kick", "exploit", "cheat", "hack", "anticheat", "anti_cheat", "crash", "kill"}
ncRegister({"FireServer", "InvokeServer"}, "remotes", function(self, method, ...)
	if typeof(self) ~= "Instance" then return end
	local cn = self.ClassName
	if cn ~= "RemoteEvent" and cn ~= "RemoteFunction" and cn ~= "UnreliableRemoteEvent" then return end
	local f = Features.remotes
	local st = f.state
	if not st then return end
	local name = self.Name
	local n = (st.out[name] or 0) + 1
	st.out[name] = n
	local o = f.opts
	if o.blockFlood and n > o.threshold then return true, {n = 0} end
	if o.flagExecutor and Caps.checkcaller and Caps.checkcaller() then
		local l = name:lower()
		local sus = false
		for _, p in ipairs(SUS_REMOTE) do if l:find(p, 1, true) then sus = true break end end
		report("RemoteEvent Monitor", "Executor script fired remote '" .. name .. "'", sus and 3 or 2, "rexec:" .. name)
	end
end)
define{
	id = "remotes", module = "exploit", name = "RemoteEvent Monitor",
	desc = "Watches outgoing and incoming remote traffic for floods and executor-originated calls.",
	opts = {threshold = 45, blockFlood = false, flagExecutor = false},
	supported = function()
		if Caps.hooks then return true end
		return false, "Needs hookmetamethod + getnamecallmethod."
	end,
	build = function(f, p)
		Ctl.Slider(p, "Flood threshold (calls / second)", f.opts, "threshold", 10, 200, 5)
		Ctl.Toggle(p, "Block outgoing floods", f.opts, "blockFlood")
		Ctl.Toggle(p, "Flag executor-fired remotes", f.opts, "flagExecutor")
		Ctl.Note(p, "Flagging executor calls will also catch scripts you run yourself.")
	end,
	start = function(f, maid)
		if not ncInstall() then error("hook unavailable") end
		local st = {out = {}, inn = {}}
		f.state = st
		maid:Add(function() f.state = nil end)
		maid:Add(task.spawn(function()
			while true do
				task.wait(1)
				local thr = f.opts.threshold
				for name, n in pairs(st.out) do
					if n > thr then
						report("RemoteEvent Monitor", string.format("Flood: '%s' fired %d×/s", name, n), n > thr * 3 and 3 or 2, "flood:" .. name)
					end
				end
				for name, n in pairs(st.inn) do
					if n > thr * 2 then
						report("RemoteEvent Monitor", string.format("Incoming flood: '%s' received %d×/s", name, n), 2, "inflood:" .. name)
					end
				end
				st.out, st.inn = {}, {}
			end
		end))
		local function hookRemote(r)
			local cn = r.ClassName
			if cn == "RemoteEvent" or cn == "UnreliableRemoteEvent" then
				if isInternal(r) then return end
				maid:Add(r.OnClientEvent:Connect(function()
					local s = f.state
					if s then s.inn[r.Name] = (s.inn[r.Name] or 0) + 1 end
				end))
			end
		end
		if ReplicatedStorage then
			maid:Add(ReplicatedStorage.DescendantAdded:Connect(hookRemote))
			task.spawn(function()
				local n = 0
				for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
					if not f.enabled then return end
					hookRemote(d)
					n = n + 1
					if n % 200 == 0 then task.wait() end
				end
			end)
		end
	end,
}

-- Character Protection -----------------------------------------------
define{
	id = "charprot", module = "exploit", name = "Character Protection",
	desc = "Anti-Void, Anti-AFK, Anti-Fling and Anti-Teleport for your character.",
	opts = {antiVoid = true, antiAfk = true, antiFling = true, antiTeleport = true, tpStrict = false, tpDistance = 60},
	build = function(f, p)
		Ctl.Toggle(p, "Anti-Void", f.opts, "antiVoid")
		Ctl.Toggle(p, "Anti-AFK", f.opts, "antiAfk")
		Ctl.Toggle(p, "Anti-Fling", f.opts, "antiFling")
		Ctl.Toggle(p, "Anti-Teleport", f.opts, "antiTeleport")
		Ctl.Toggle(p, "Strict teleport mode (revert every unexplained jump)", f.opts, "tpStrict")
		Ctl.Slider(p, "Teleport distance (studs)", f.opts, "tpDistance", 30, 200, 10)
		Ctl.Note(p, "By default Anti-Teleport only reverts jumps that happen near other players or into the void. Teleports started by the game itself (checkpoints, doors, respawns) are let through — strict mode reverts those too.")
	end,
	start = function(f, maid)
		local o = f.opts
		local prevPos, lastSafe, safeT = nil, nil, 0
		local function nearOthers(pos)
			for _, pl in ipairs(Players:GetPlayers()) do
				if pl ~= LocalPlayer and pl.Character then
					local hrp = pl.Character:FindFirstChild("HumanoidRootPart")
					if hrp and (hrp.Position - pos).Magnitude < 30 then return true end
				end
			end
			return false
		end
		maid:Add(LocalPlayer.Idled:Connect(function()
			if o.antiAfk then
				pcall(function()
					VirtualUser:CaptureController()
					VirtualUser:ClickButton2(Vector2.new(0, 0))
				end)
			end
		end))
		maid:Add(LocalPlayer.CharacterAdded:Connect(function() prevPos, lastSafe = nil, nil end))
		maid:Add(RunService.Heartbeat:Connect(function(dt)
			local c = LocalPlayer.Character
			local h = c and c:FindFirstChildOfClass("Humanoid")
			local r = c and c:FindFirstChild("HumanoidRootPart")
			if not (h and r) or h.Health <= 0 then prevPos = nil return end
			local pos = r.Position
			local vel = r.AssemblyLinearVelocity
			local fpdh = Workspace.FallenPartsDestroyHeight
			if fpdh ~= fpdh or fpdh < -1e5 then fpdh = -500 end
			-- anti-teleport
			if o.antiTeleport and prevPos then
				local dist = (pos - prevPos).Magnitude
				if dist > o.tpDistance and dist > vel.Magnitude * dt * 3 + 20 then
					local void = pos.Y < fpdh + 150
					if o.tpStrict or void or nearOthers(prevPos) or nearOthers(pos) then
						r.CFrame = CFrame.new(prevPos) * r.CFrame.Rotation
						r.AssemblyLinearVelocity = Vector3.zero
						report("Character Protection", string.format("Reverted a %d-stud teleport.", math.floor(dist)), 2, "tp")
						pos = prevPos
					end
				end
			end
			-- anti-void
			if o.antiVoid then
				if pos.Y < fpdh + 80 and lastSafe then
					r.CFrame = lastSafe + Vector3.new(0, 4, 0)
					r.AssemblyLinearVelocity = Vector3.zero
					r.AssemblyAngularVelocity = Vector3.zero
					report("Character Protection", "Pulled you back from the void.", 2, "void")
					pos = r.Position
				elseif os.clock() - safeT > 0.25 and h.FloorMaterial ~= Enum.Material.Air and pos.Y > fpdh + 200 then
					lastSafe, safeT = r.CFrame, os.clock()
				end
			end
			-- anti-fling
			if o.antiFling then
				if vel.Magnitude > 250 or r.AssemblyAngularVelocity.Magnitude > 120 then
					r.AssemblyLinearVelocity = Vector3.zero
					r.AssemblyAngularVelocity = Vector3.zero
					report("Character Protection", "Neutralised fling-level velocity.", 2, "fling")
				end
			end
			prevPos = pos
		end))
		maid:Add(RunService.Stepped:Connect(function()
			if not o.antiFling then return end
			for _, pl in ipairs(Players:GetPlayers()) do
				if pl ~= LocalPlayer and pl.Character then
					for _, part in ipairs(pl.Character:GetChildren()) do
						local cn = part.ClassName
						if (cn == "Part" or cn == "MeshPart") and part.CanCollide then part.CanCollide = false end
					end
				end
			end
		end))
	end,
}

local CORE_OK = {
	RobloxGui = true, ThemeProvider = true, TopBarApp = true, ExperienceChat = true, PlayerList = true, Chat = true,
	BubbleChat = true, Backpack = true, Health = true, EmotesMenu = true, TouchGui = true, RobloxTouchGui = true,
	PurchasePromptApp = true, RobloxNetworkPauseNotification = true, InGameMenu = true,
	TeleportGui = true, ErrorPrompt = true, RobloxPromptGui = true, RobloxLoadingGui = true, FoundationOverlay = true,
	ScreenshotUi = true, Freecam = true, VoiceChat = true, TopBar = true, ControlGui = true,
}

local function isRobloxCoreUi(inst)
	if not CoreGui then return false end
	local current = inst
	while current and current ~= CoreGui do
		if current.Parent == CoreGui then
			return CORE_OK[current.Name] == true
		end
		current = current.Parent
	end
	return false
end

-- Suspicious Instance Detector ---------------------------------------
local RISK = {
	BodyVelocity = 1, BodyGyro = 1, BodyPosition = 1, BodyAngularVelocity = 1, BodyThrust = 1, BodyForce = 1,
	RocketPropulsion = 1, LinearVelocity = 1, AngularVelocity = 1, AlignPosition = 1, AlignOrientation = 1,
	VectorForce = 1, Torque = 1,
	Highlight = 2, BoxHandleAdornment = 2, SphereHandleAdornment = 2, CylinderHandleAdornment = 2,
	ConeHandleAdornment = 2, LineHandleAdornment = 2, SelectionBox = 2, SelectionSphere = 2,
	RemoteEvent = 3, RemoteFunction = 3,
	LocalScript = 4, ModuleScript = 4, Script = 4,
}
local SAFE_CHAR_SCRIPTS = {Animate = true, Health = true, Sound = true, RbxCharacterSounds = true, CharacterSounds = true}
define{
	id = "instances", module = "exploit", name = "Suspicious Instance Detector",
	desc = "Flags unexpected movers, ESP adornments, scripts and remotes that appear on you, your camera or in CoreGui.",
	start = function(f, maid)
		local graceUntil = os.clock() + 3
		local function consider(inst, where, cats)
			if os.clock() < graceUntil then return end
			local cat = RISK[inst.ClassName]
			if not cat or not cats[cat] or isInternal(inst) or isRobloxCoreUi(inst) then return end
			if cat == 4 and where == "your character" and SAFE_CHAR_SCRIPTS[inst.Name] then return end
			report("Instance Detector", string.format("%s '%s' appeared in %s", inst.ClassName, inst.Name, where), cat == 1 and 3 or 2, "inst:" .. inst.ClassName .. where)
		end
		local charConn
		local function watchChar(c)
			graceUntil = os.clock() + 3
			if charConn then charConn:Disconnect() end
			charConn = c.DescendantAdded:Connect(function(i) consider(i, "your character", {[1] = true, [4] = true}) end)
		end
		maid:Add(function() if charConn then charConn:Disconnect() end end)
		if LocalPlayer.Character then watchChar(LocalPlayer.Character) end
		maid:Add(LocalPlayer.CharacterAdded:Connect(watchChar))
		local camConn
		local function watchCam()
			if camConn then camConn:Disconnect() end
			local cam = Workspace.CurrentCamera
			if cam then camConn = cam.DescendantAdded:Connect(function(i) consider(i, "the camera", {[1] = true, [2] = true}) end) end
		end
		maid:Add(function() if camConn then camConn:Disconnect() end end)
		watchCam()
		maid:Add(Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCam))
		pcall(function()
			maid:Add(CoreGui.DescendantAdded:Connect(function(i) consider(i, "CoreGui", {[2] = true, [3] = true, [4] = true}) end))
		end)
	end,
}

-- GUI Protection -----------------------------------------------------
local HUB_EXACT = {dex = true, dexv2 = true, iy = true, simplespy = true, remotespy = true, hydroxide = true}
local HUB_SUB = {"infinite yield", "infiniteyield", "exploit", "aimbot", "cheat", "hack", "scripthub", "script hub", "executor", "remotespy", "simplespy", "hydroxide", "rayfield", "kavo", "dex explorer"}

local function hubMatch(name)
	local l = name:lower()
	if HUB_EXACT[l] then return true end
	for _, p in ipairs(HUB_SUB) do if l:find(p, 1, true) then return true end end
	return false
end
define{
	id = "guidetect", module = "exploit", name = "GUI Protection",
	desc = "Detects suspicious GUI injections: new CoreGui interfaces, known hub names and invisible click-trap overlays.",
	opts = {autoRemove = false, clickjack = true},
	build = function(f, p)
		Ctl.Toggle(p, "Detect invisible click-trap overlays", f.opts, "clickjack")
		Ctl.Toggle(p, "Auto-remove high-severity injections", f.opts, "autoRemove")
		Ctl.Note(p, "Auto-remove disables and destroys the offending GUI. Leave it off if you run your own tools.")
	end,
	start = function(f, maid)
		local baseline = {}
		pcall(function() for _, c in ipairs(CoreGui:GetChildren()) do baseline[c] = true end end)
		local function trap(gui)
			local vp = UI.gui.AbsoluteSize
			local n = 0
			for _, d in ipairs(gui:GetDescendants()) do
				n = n + 1
				if n > 250 then break end
				if (d.ClassName == "TextButton" or d.ClassName == "ImageButton") and d.Visible then
					local s = d.AbsoluteSize
					if s.X >= vp.X * 0.9 and s.Y >= vp.Y * 0.9 and d.BackgroundTransparency >= 0.9 then return true end
				end
			end
			return false
		end
		local function judge(gui, where)
			if isInternal(gui) then return end
			local cn = gui.ClassName
			if cn ~= "ScreenGui" and cn ~= "BillboardGui" and cn ~= "SurfaceGui" then return end
			local sev, why
			if hubMatch(gui.Name) then sev, why = 3, "matches a known exploit-hub name"
			elseif where == "CoreGui" and not baseline[gui] and not CORE_OK[gui.Name] then sev, why = 2, "was injected into CoreGui" end
			if not sev and f.opts.clickjack and cn == "ScreenGui" then
				task.delay(0.6, function()
					if f.enabled and gui.Parent and trap(gui) then
						report("GUI Protection", string.format("'%s' contains an invisible full-screen click trap", gui.Name), 3, "trap:" .. gui.Name)
						if f.opts.autoRemove then gui.Enabled = false; pcall(gui.Destroy, gui) end
					end
				end)
			end
			if sev then
				report("GUI Protection", string.format("GUI '%s' %s (%s)", gui.Name, why, where), sev, "gui:" .. gui.Name)
				if sev == 3 and f.opts.autoRemove then
					pcall(function() gui.Enabled = false end)
					pcall(gui.Destroy, gui)
				end
			end
		end
		pcall(function() maid:Add(CoreGui.ChildAdded:Connect(function(g) judge(g, "CoreGui") end)) end)
		maid:Add(PlayerGui.ChildAdded:Connect(function(g) judge(g, "PlayerGui") end))
		if Container ~= CoreGui and Container ~= PlayerGui then
			pcall(function() maid:Add(Container.ChildAdded:Connect(function(g) judge(g, "UI container") end)) end)
		end
	end,
}

